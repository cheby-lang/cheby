//! The built-in `I8`, a signed 8-bit integer: constants, conversions,
//! parsing and text, comparison, and checked and wrapping arithmetic
//! (the integer families of `docs/stdlib/README.md`, D-350).
//!
//! `I8` itself is a builtin item whose home module is this one (D-447).

import std::int

// Constants

/// The smallest `I8`.
pub const min_value: I8 = -128

/// The largest `I8`.
pub const max_value: I8 = 127

// Conversions

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_int")
@external(js, "./i8.mjs", "from_int")
pub fn from_int(n: Int) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_i16")
@external(js, "./i8.mjs", "from_i16")
pub fn from_i16(n: I16) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_i32")
@external(js, "./i8.mjs", "from_i32")
pub fn from_i32(n: I32) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_i64")
@external(js, "./i8.mjs", "from_i64")
pub fn from_i64(n: I64) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_u8")
@external(js, "./i8.mjs", "from_u8")
pub fn from_u8(n: U8) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_u16")
@external(js, "./i8.mjs", "from_u16")
pub fn from_u16(n: U16) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_u32")
@external(js, "./i8.mjs", "from_u32")
pub fn from_u32(n: U32) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_u64")
@external(js, "./i8.mjs", "from_u64")
pub fn from_u64(n: U64) -> Result<I8, Nil>

// Parsing and text

/// Reads an `I8` written as an optional `-` and ASCII decimal digits (D-312).
@external(native, "cheby_i8_parse")
@external(js, "./i8.mjs", "parse")
pub fn parse(text: String) -> Result<I8, Nil>

/// Reads an `I8` written in `base`, from 2 to 36, as an optional `-` and digits.
@external(native, "cheby_i8_parse_base")
@external(js, "./i8.mjs", "parse_base")
pub fn parse_base(text: String, base: Int) -> Result<I8, Nil>

/// Returns `n` in decimal. It makes `I8` satisfy `Show`.
@external(native, "cheby_i8_show")
@external(js, "./i8.mjs", "show")
pub fn show(n: I8) -> String

// Comparison

/// Orders two `I8` values. It makes `I8` satisfy `Compare`.
pub fn compare(a: I8, b: I8) -> Order {
  case {
    a < b => Less
    a > b => Greater
    _ => Equal
  }
}

/// Returns the smaller of `a` and `b`, and `a` when they are `Equal`.
pub fn min(a: I8, b: I8) -> I8 {
  case {
    b < a => b
    _ => a
  }
}

/// Returns the larger of `a` and `b`, and `a` when they are `Equal`.
pub fn max(a: I8, b: I8) -> I8 {
  case {
    b > a => b
    _ => a
  }
}

// Arithmetic

/// Returns `a + b`, and panics when the result does not fit. It makes `I8` satisfy `Add`.
pub fn add(a: I8, b: I8) -> I8 {
  a + b
}

/// Returns `a - b`, and panics when the result does not fit. It makes `I8` satisfy `Sub`.
pub fn sub(a: I8, b: I8) -> I8 {
  a - b
}

/// Returns `a * b`, and panics when the result does not fit. It makes `I8` satisfy `Mul`.
pub fn mul(a: I8, b: I8) -> I8 {
  a * b
}

/// Returns `a / b` toward zero, panicking like `/`. It makes `I8` satisfy `Div`.
pub fn div(a: I8, b: I8) -> I8 {
  a / b
}

/// Returns `a % b`, with the sign of `a`, and panics on a zero divisor.
pub fn rem(a: I8, b: I8) -> I8 {
  a % b
}

/// Returns `-n`, and panics when it does not fit. It makes `I8` satisfy `Neg`.
pub fn neg(n: I8) -> I8 {
  -n
}

/// Returns `n` without its sign, and panics for `min_value`, like `neg`.
pub fn abs(n: I8) -> I8 {
  case {
    n < 0 => -n
    _ => n
  }
}

// Checked arithmetic

/// Returns `Ok(a + b)`, or `Err(Nil)` when the sum does not fit (D-309).
@external(native, "cheby_i8_checked_add")
@external(js, "./i8.mjs", "checked_add")
pub fn checked_add(a: I8, b: I8) -> Result<I8, Nil>

/// Returns `Ok(a - b)`, or `Err(Nil)` when the difference does not fit (D-309).
@external(native, "cheby_i8_checked_sub")
@external(js, "./i8.mjs", "checked_sub")
pub fn checked_sub(a: I8, b: I8) -> Result<I8, Nil>

/// Returns `Ok(a * b)`, or `Err(Nil)` when the product does not fit (D-309).
@external(native, "cheby_i8_checked_mul")
@external(js, "./i8.mjs", "checked_mul")
pub fn checked_mul(a: I8, b: I8) -> Result<I8, Nil>

/// Returns `Ok(a / b)`, or `Err(Nil)` for a zero divisor and for `min_value / -1` (D-356).
pub fn checked_div(a: I8, b: I8) -> Result<I8, Nil> {
  // Dividing by -1 overflows exactly when negating does.
  case b {
    0 => Err(Nil)
    -1 => checked_neg(a)
    _ => Ok(a / b)
  }
}

/// Returns `Ok(a % b)`, or `Err(Nil)` for a zero divisor (D-356).
pub fn checked_rem(a: I8, b: I8) -> Result<I8, Nil> {
  case b {
    0 => Err(Nil)
    _ => Ok(a % b)
  }
}

/// Returns `Ok(-n)`, or `Err(Nil)` for `min_value` (D-309).
pub fn checked_neg(n: I8) -> Result<I8, Nil> {
  case {
    n == min_value => Err(Nil)
    _ => Ok(-n)
  }
}

// Wrapping arithmetic

/// Returns `a + b` modulo 2^8 (D-025).
@external(native, "cheby_i8_wrapping_add")
@external(js, "./i8.mjs", "wrapping_add")
pub fn wrapping_add(a: I8, b: I8) -> I8

/// Returns `a - b` modulo 2^8 (D-025).
@external(native, "cheby_i8_wrapping_sub")
@external(js, "./i8.mjs", "wrapping_sub")
pub fn wrapping_sub(a: I8, b: I8) -> I8

/// Returns `a * b` modulo 2^8 (D-025).
@external(native, "cheby_i8_wrapping_mul")
@external(js, "./i8.mjs", "wrapping_mul")
pub fn wrapping_mul(a: I8, b: I8) -> I8

/// Returns `-n` modulo 2^8 (D-025).
@external(native, "cheby_i8_wrapping_neg")
@external(js, "./i8.mjs", "wrapping_neg")
pub fn wrapping_neg(n: I8) -> I8

// Examples

test "the i8 range" {
  assert min_value == -128
  assert max_value == 127
}

test "conversions to i8" {
  assert from_int(-128) == Ok(-128)
  assert from_int(128) == Err(Nil)
  assert from_i32(-5) == Ok(-5)
  assert from_u8(200) == Err(Nil)
}

test "i8 parses and shows decimal digits" {
  let small: I8 = -5
  assert parse("-128") == Ok(-128)
  assert parse("128") == Err(Nil)
  assert parse("+1") == Err(Nil)
  assert parse_base("7f", 16) == Ok(127)
  assert show(-128) == "-128"
  assert "{small}" == "-5"
}

test "comparing i8 values" {
  assert compare(-1, 1) == Less
  assert compare(3, 3) == Equal
  assert min(-100, 7) == -100
  assert max(-100, 7) == 7
}

test "i8 operators as functions" {
  assert add(100, 27) == 127
  assert sub(-100, 28) == -128
  assert mul(-4, 5) == -20
  assert div(-7, 2) == -3
  assert rem(-7, 2) == -1
  assert neg(127) == -127
  assert abs(-127) == 127
}

test "i8 checked arithmetic reports overflow" {
  assert checked_add(100, 27) == Ok(127)
  assert checked_add(max_value, 1) == Err(Nil)
  assert checked_sub(min_value, 1) == Err(Nil)
  assert checked_mul(max_value, 2) == Err(Nil)
  assert checked_div(min_value, -1) == Err(Nil)
  assert checked_rem(7, 0) == Err(Nil)
  assert checked_neg(min_value) == Err(Nil)
}

test "i8 wrapping arithmetic wraps around" {
  assert wrapping_add(max_value, 1) == min_value
  assert wrapping_sub(min_value, 1) == max_value
  assert wrapping_mul(max_value, 2) == -2
  assert wrapping_neg(min_value) == min_value
}

// Tests of `std::int` that need this module.

test "from_i8 widens" {
  assert int::from_i8(-128) == -128
  assert int::from_i8(max_value) == 127
}
