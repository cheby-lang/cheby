}

/// Keeps the low 8 bits of `n`'s two's-complement value and reads them as an `I8` (D-P12).
pub fn wrapping_from_u64(n: U64) -> I8 {
  let low = n & 0xFF
  case low < 0x80 {
    True => {
      let assert Ok(value) = from_u64(low)
      value
    }
    False => {
      // `0xFF - low` fits, and minus it minus 1 is `low` - 2^8.
