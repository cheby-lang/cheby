//! The built-in `I8`, a signed 8-bit integer: constants, conversions,
//! parsing and text, comparison, and checked and wrapping arithmetic
//! (the integer families of `docs/stdlib/README.md`, D-350).
//!
//! `I8` itself is a builtin item whose home module is this one (D-447).

import std::int

// Constants

/// The smallest `I8`.
pub const min_value: I8 = -128

/// The largest `I8`.
pub const max_value: I8 = 127

// Conversions

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_int")
@external(js, "./i8.mjs", "from_int")
pub fn from_int(n: Int) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_i16")
@external(js, "./i8.mjs", "from_i16")
pub fn from_i16(n: I16) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_i32")
@external(js, "./i8.mjs", "from_i32")
pub fn from_i32(n: I32) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_i64")
@external(js, "./i8.mjs", "from_i64")
pub fn from_i64(n: I64) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_u8")
@external(js, "./i8.mjs", "from_u8")
pub fn from_u8(n: U8) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_u16")
@external(js, "./i8.mjs", "from_u16")
pub fn from_u16(n: U16) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_u32")
@external(js, "./i8.mjs", "from_u32")
pub fn from_u32(n: U32) -> Result<I8, Nil>

/// Returns `n` as an `I8`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_i8_from_u64")
@external(js, "./i8.mjs", "from_u64")
pub fn from_u64(n: U64) -> Result<I8, Nil>

/// Keeps the low 8 bits of `n`'s two's-complement value and reads them as an `I8` (D-P12).
pub fn wrapping_from_int(n: Int) -> I8 {
  let low = n & 0xFF
  case low < 0x80 {
    True => {
      let assert Ok(value) = from_int(low)
      value
    }
    False => {
      // `0xFF - low` fits, and minus it minus 1 is `low` - 2^8.
      let assert Ok(complement) = from_int(0xFF - low)
      -complement - 1
    }
  }
}

/// Keeps the low 8 bits of `n`'s two's-complement value and reads them as an `I8` (D-P12).
pub fn wrapping_from_i16(n: I16) -> I8 {
  let low = n & 0xFF
  case low < 0x80 {
    True => {
      let assert Ok(value) = from_i16(low)
      value
    }
    False => {
      // `0xFF - low` fits, and minus it minus 1 is `low` - 2^8.
      let assert Ok(complement) = from_i16(0xFF - low)
      -complement - 1
    }
  }
}

/// Keeps the low 8 bits of `n`'s two's-complement value and reads them as an `I8` (D-P12).
pub fn wrapping_from_i32(n: I32) -> I8 {
  let low = n & 0xFF
  case low < 0x80 {
    True => {
      let assert Ok(value) = from_i32(low)
      value
    }
    False => {
      // `0xFF - low` fits, and minus it minus 1 is `low` - 2^8.
      let assert Ok(complement) = from_i32(0xFF - low)
      -complement - 1
    }
  }
}

/// Keeps the low 8 bits of `n`'s two's-complement value and reads them as an `I8` (D-P12).
pub fn wrapping_from_i64(n: I64) -> I8 {
  let low = n & 0xFF
  case low < 0x80 {
    True => {
      let assert Ok(value) = from_i64(low)
      value
    }
    False => {
      // `0xFF - low` fits, and minus it minus 1 is `low` - 2^8.
      let assert Ok(complement) = from_i64(0xFF - low)
      -complement - 1
    }
  }
}

/// Keeps the low 8 bits of `n`'s two's-complement value and reads them as an `I8` (D-P12).
pub fn wrapping_from_u8(n: U8) -> I8 {
  case n < 0x80 {
    True => {
      let assert Ok(value) = from_u8(n)
      value
    }
    False => {
      // `0xFF - n` fits, and minus it minus 1 is `n` - 2^8.
      let assert Ok(complement) = from_u8(0xFF - n)
      -complement - 1
    }
  }
}

/// Keeps the low 8 bits of `n`'s two's-complement value and reads them as an `I8` (D-P12).
pub fn wrapping_from_u16(n: U16) -> I8 {
  let low = n & 0xFF
  case low < 0x80 {
    True => {
      let assert Ok(value) = from_u16(low)
      value
    }
    False => {
      // `0xFF - low` fits, and minus it minus 1 is `low` - 2^8.
      let assert Ok(complement) = from_u16(0xFF - low)
      -complement - 1
    }
  }
}

/// Keeps the low 8 bits of `n`'s two's-complement value and reads them as an `I8` (D-P12).
pub fn wrapping_from_u32(n: U32) -> I8 {
  let low = n & 0xFF
  case low < 0x80 {
    True => {
      let assert Ok(value) = from_u32(low)
      value
    }
    False => {
      // `0xFF - low` fits, and minus it minus 1 is `low` - 2^8.
      let assert Ok(complement) = from_u32(0xFF - low)
