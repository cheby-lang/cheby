//! The built-in `U32`, a unsigned 32-bit integer: constants, conversions,
//! parsing and text, comparison, and checked and wrapping arithmetic
//! (the integer families of `docs/stdlib/README.md`, D-350).
//!
//! `U32` itself is a builtin item whose home module is this one (D-447).

// Constants

/// The smallest `U32`.
pub const min_value: U32 = 0

/// The largest `U32`.
pub const max_value: U32 = 4_294_967_295

// Conversions

/// Returns `n` as an `U32`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_u32_from_int")
@external(js, "./u32.mjs", "from_int")
pub fn from_int(n: Int) -> Result<U32, Nil>

/// Returns `n` as an `U32`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_u32_from_i8")
@external(js, "./u32.mjs", "from_i8")
pub fn from_i8(n: I8) -> Result<U32, Nil>

/// Returns `n` as an `U32`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_u32_from_i16")
@external(js, "./u32.mjs", "from_i16")
pub fn from_i16(n: I16) -> Result<U32, Nil>

/// Returns `n` as an `U32`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_u32_from_i32")
@external(js, "./u32.mjs", "from_i32")
pub fn from_i32(n: I32) -> Result<U32, Nil>

/// Returns `n` as an `U32`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_u32_from_i64")
@external(js, "./u32.mjs", "from_i64")
pub fn from_i64(n: I64) -> Result<U32, Nil>

/// Returns `n` as an `U32`. Every `U8` fits.
@external(native, "cheby_u32_from_u8")
@external(js, "./u32.mjs", "from_u8")
pub fn from_u8(n: U8) -> U32

/// Returns `n` as an `U32`. Every `U16` fits.
@external(native, "cheby_u32_from_u16")
@external(js, "./u32.mjs", "from_u16")
pub fn from_u16(n: U16) -> U32

/// Returns `n` as an `U32`, or `Err(Nil)` when it does not fit.
@external(native, "cheby_u32_from_u64")
@external(js, "./u32.mjs", "from_u64")
pub fn from_u64(n: U64) -> Result<U32, Nil>

// Parsing and text

/// Reads an `U32` written as an optional `-` and ASCII decimal digits (D-312).
@external(native, "cheby_u32_parse")
@external(js, "./u32.mjs", "parse")
pub fn parse(text: String) -> Result<U32, Nil>

/// Reads an `U32` written in `base`, from 2 to 36, as an optional `-` and digits.
@external(native, "cheby_u32_parse_base")
@external(js, "./u32.mjs", "parse_base")
pub fn parse_base(text: String, base: Int) -> Result<U32, Nil>

/// Returns `n` in decimal. It makes `U32` satisfy `Show`.
@external(native, "cheby_u32_show")
@external(js, "./u32.mjs", "show")
pub fn show(n: U32) -> String

// Comparison

/// Orders two `U32` values. It makes `U32` satisfy `Compare`.
pub fn compare(a: U32, b: U32) -> Order {
  case {
    a < b => Less
    a > b => Greater
    _ => Equal
  }
}

/// Returns the smaller of `a` and `b`, and `a` when they are `Equal`.
pub fn min(a: U32, b: U32) -> U32 {
  case {
    b < a => b
    _ => a
  }
}

/// Returns the larger of `a` and `b`, and `a` when they are `Equal`.
pub fn max(a: U32, b: U32) -> U32 {
  case {
    b > a => b
    _ => a
  }
}

// Arithmetic

/// Returns `a + b`, and panics when the result does not fit. It makes `U32` satisfy `Add`.
pub fn add(a: U32, b: U32) -> U32 {
  a + b
}

/// Returns `a - b`, and panics when the result does not fit. It makes `U32` satisfy `Sub`.
pub fn sub(a: U32, b: U32) -> U32 {
  a - b
}

/// Returns `a * b`, and panics when the result does not fit. It makes `U32` satisfy `Mul`.
pub fn mul(a: U32, b: U32) -> U32 {
  a * b
}

/// Returns `a / b` toward zero, panicking like `/`. It makes `U32` satisfy `Div`.
pub fn div(a: U32, b: U32) -> U32 {
  a / b
}

/// Returns `a % b`, with the sign of `a`, and panics on a zero divisor.
pub fn rem(a: U32, b: U32) -> U32 {
  a % b
}

/// Returns `-n`, and panics when it does not fit. It makes `U32` satisfy `Neg`.
pub fn neg(n: U32) -> U32 {
  -n
}

/// Returns `n`, since `U32` has no negative values.
pub fn abs(n: U32) -> U32 {
  n
}

// Checked arithmetic

/// Returns `Ok(a + b)`, or `Err(Nil)` when the sum does not fit (D-309).
@external(native, "cheby_u32_checked_add")
@external(js, "./u32.mjs", "checked_add")
pub fn checked_add(a: U32, b: U32) -> Result<U32, Nil>

/// Returns `Ok(a - b)`, or `Err(Nil)` when the difference does not fit (D-309).
@external(native, "cheby_u32_checked_sub")
@external(js, "./u32.mjs", "checked_sub")
pub fn checked_sub(a: U32, b: U32) -> Result<U32, Nil>

/// Returns `Ok(a * b)`, or `Err(Nil)` when the product does not fit (D-309).
@external(native, "cheby_u32_checked_mul")
@external(js, "./u32.mjs", "checked_mul")
pub fn checked_mul(a: U32, b: U32) -> Result<U32, Nil>

/// Returns `Ok(a / b)`, or `Err(Nil)` for a zero divisor (D-356).
pub fn checked_div(a: U32, b: U32) -> Result<U32, Nil> {
  case b {
    0 => Err(Nil)
    _ => Ok(a / b)
  }
}

/// Returns `Ok(a % b)`, or `Err(Nil)` for a zero divisor (D-356).
pub fn checked_rem(a: U32, b: U32) -> Result<U32, Nil> {
  case b {
    0 => Err(Nil)
    _ => Ok(a % b)
  }
}

/// Returns `Ok(n)` for 0, the only value whose negation fits, and `Err(Nil)` otherwise (D-309).
pub fn checked_neg(n: U32) -> Result<U32, Nil> {
  case n {
    0 => Ok(n)
    _ => Err(Nil)
  }
}

// Wrapping arithmetic

/// Returns `a + b` modulo 2^32 (D-025).
@external(native, "cheby_u32_wrapping_add")
@external(js, "./u32.mjs", "wrapping_add")
pub fn wrapping_add(a: U32, b: U32) -> U32

/// Returns `a - b` modulo 2^32 (D-025).
@external(native, "cheby_u32_wrapping_sub")
@external(js, "./u32.mjs", "wrapping_sub")
pub fn wrapping_sub(a: U32, b: U32) -> U32

/// Returns `a * b` modulo 2^32 (D-025).
@external(native, "cheby_u32_wrapping_mul")
@external(js, "./u32.mjs", "wrapping_mul")
pub fn wrapping_mul(a: U32, b: U32) -> U32

/// Returns `-n` modulo 2^32 (D-025).
@external(native, "cheby_u32_wrapping_neg")
@external(js, "./u32.mjs", "wrapping_neg")
pub fn wrapping_neg(n: U32) -> U32

// Examples

test "the u32 range" {
  assert min_value == 0
  assert max_value == 4_294_967_295
}

test "conversions to u32" {
  assert from_u8(255) == 255
  assert from_u16(65535) == 65535
  assert from_int(4_294_967_295) == Ok(4_294_967_295)
  assert from_int(-1) == Err(Nil)
  assert from_u64(4_294_967_296) == Err(Nil)
}

test "u32 parses and shows decimal digits" {
  let small: U32 = 7
  assert parse("4294967295") == Ok(4_294_967_295)
  assert parse("-1") == Err(Nil)
  assert parse_base("ffffffff", 16) == Ok(max_value)
  assert show(max_value) == "4294967295"
  assert "{small}" == "7"
}

test "comparing u32 values" {
  assert compare(1, 2) == Less
  assert compare(3, 3) == Equal
  assert min(100, 7) == 7
  assert max(100, 7) == 100
}

test "u32 operators as functions" {
  assert add(200, 55) == 255
  assert sub(7, 2) == 5
  assert mul(15, 17) == 255
  assert div(7, 2) == 3
  assert rem(7, 2) == 1
  assert neg(0) == 0
  assert abs(7) == 7
}

test "u32 checked arithmetic reports overflow" {
  assert checked_add(200, 55) == Ok(255)
  assert checked_add(max_value, 1) == Err(Nil)
  assert checked_sub(0, 1) == Err(Nil)
  assert checked_mul(max_value, 2) == Err(Nil)
  assert checked_div(7, 0) == Err(Nil)
  assert checked_rem(7, 2) == Ok(1)
  assert checked_neg(0) == Ok(0)
  assert checked_neg(1) == Err(Nil)
}

test "u32 wrapping arithmetic wraps around" {
  assert wrapping_add(max_value, 1) == 0
  assert wrapping_sub(0, 1) == max_value
  assert wrapping_mul(max_value, 2) == max_value - 1
  assert wrapping_neg(1) == max_value
}
