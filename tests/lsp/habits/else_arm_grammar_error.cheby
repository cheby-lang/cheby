// @decisions: D-1353, D-1388, D-1393, D-1401, D-1736
//! An `else =>` arm of a `case` becomes `_ =>` (X §6.5).
//! With a grammar error in another function, so the fix keeps its raw
//! edits (D-1735).

fn name(a: Int) -> String {
  case a {
    1 => "one"
    else => "many"
  }
}

fn main() {
  assert name(2) == "many"
}

fn broken() {
  let = 1
}
//> 9:5 action Write `_`
