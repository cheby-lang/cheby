// @decisions: D-1353, D-1388, D-1393, D-1401, D-1736
//! A type written `int` becomes `Int` (X §6.5).
//! With a grammar error in another function, so the fix keeps its raw
//! edits (D-1735).

fn twice(a: int) -> Int {
  a * 2
}

fn main() {
  assert twice(2) == 4
}

fn broken() {
  let = 1
}
//> 6:13 action Write `Int`
