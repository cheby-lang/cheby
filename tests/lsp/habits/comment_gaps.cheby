// @decisions: D-1401, D-1690, D-1736
// @client: full
//! A rewrite that would drop a comment is `disabled` (plan §1.11), and the
//! `full` client, which shows disabled actions, lists it with its reason
//! and with no edit (D-1690). A comment between a condition and its `{`
//! stays out of the arm's condition, so it counts as dropped.

fn pick(flag: Bool) -> Int {
  let n = if flag {
    // kept
    1
  } // dropped
  else { 2 }
  n
}

fn early(a: Int) -> Int {
  if a > 0 {
    // dropped
    return 1
  }
  a
}

fn brace(flag: Bool) -> Int {
  let n = if flag // dropped
  { 1 } else { 2 }
  n
}

fn main() {
  assert pick(True) + early(0) + brace(True) == 2
}
