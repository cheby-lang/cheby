// @decisions: D-1353, D-1388, D-1393, D-1401, D-1736, D-1753
// @newErrors: E0047
//! A `for` loop becomes `list::each` with a closure, and `std::list` is
//! imported (X §6.5).
//! With a type error in another function, which the fix reveals.

import std::io

fn show(xs: List<Int>) {
  for x in xs { io::println("{x}") }
}

fn main() {
  show([1, 2])
}

fn answer() -> Int {
  "forty-two"
}
//> 10:7 action Rewrite as `list::each`
