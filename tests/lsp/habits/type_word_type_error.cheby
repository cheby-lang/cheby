// @decisions: D-1353, D-1388, D-1393, D-1401, D-1736, D-1931
// @newErrors: E0047
//! A type written `int` becomes `Int` through its help's edit (X §6.5,
//! D-1931).
//! With a type error in another function, which the fix reveals.

fn twice(a: int) -> Int {
  a * 2
}

fn main() {
  assert twice(2) == 4
}

fn answer() -> Int {
  "forty-two"
}
//> 7:13 action type names start with an upper-case letter; write `Int`
