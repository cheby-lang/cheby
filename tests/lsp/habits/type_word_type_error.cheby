// @decisions: D-1353, D-1388, D-1393, D-1401, D-1736
// @newErrors: E0047
//! A type written `int` becomes `Int` (X §6.5).
//! With a type error in another function, which the fix reveals.

fn twice(a: int) -> Int {
  a * 2
}

fn main() {
  assert twice(2) == 4
}

fn answer() -> Int {
  "forty-two"
}
//> 6:13 action Write `Int`
