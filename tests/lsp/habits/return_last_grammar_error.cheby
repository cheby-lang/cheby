// @decisions: D-1353, D-1388, D-1393, D-1401, D-1736
//! The `return` of a function's last expression is removed (X §6.5).
//! With a grammar error in another function, so the fix keeps its raw
//! edits (D-1735).

fn last(a: Int) -> Int {
  return a + 1
}

fn main() {
  assert last(1) == 2
}

fn broken() {
  let = 1
}
//> 7:10 action Remove the `return`
