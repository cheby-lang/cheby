// @decisions: D-1353, D-1388, D-1393, D-1401, D-1736
// @newErrors: E0047
//! An `if` whose block is one `return`, in a function's body block,
//! becomes a `guard` with the condition negated as `!( )` (X §6.5).
//! With a type error in another function, which the fix reveals.

fn early(a: Int) -> Int {
  if a > 0 { return 1 }
  a
}

fn main() {
  assert early(2) == 1
}

fn answer() -> Int {
  "forty-two"
}
//> 8:6 action Rewrite as `guard`
