// @decisions: D-1353, D-1388, D-1393, D-1401, D-1736, D-1931, D-425
//! `true` written as a value becomes `True` through its help's edit (X §6.5,
//! P-4, D-1931).
//! With a grammar error in another function, only the token checks
//! run, so E0042 is not reported and no fix is offered (D-425).

fn ready() -> Bool {
  true
}

fn main() {
  assert ready()
}

fn broken() {
  let = 1
}
//> 8:3 noAction `Bool`'s constructors are `True` and `False`; write `True`
