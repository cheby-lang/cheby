// @decisions: D-1353, D-1388, D-1393, D-1401, D-1736, D-425
//! `true` written as a value becomes `True` (X §6.5, P-4).
//! With a grammar error in another function, only the token checks
//! run, so E0042 is not reported and no fix is offered (D-425).

fn ready() -> Bool {
  true
}

fn main() {
  assert ready()
}

fn broken() {
  let = 1
}
//> 7:3 noAction Write `True`
