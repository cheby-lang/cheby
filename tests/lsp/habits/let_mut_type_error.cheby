// @decisions: D-1353, D-1388, D-1393, D-1401, D-1736
// @newErrors: E0047
//! `let mut` loses its `mut` (X §6.5).
//! With a type error in another function, which the fix reveals.

fn count(a: Int) -> Int {
  let mut y = a + 1
  y
}

fn main() {
  assert count(1) == 2
}

fn answer() -> Int {
  "forty-two"
}
//> 7:11 action Remove `mut`
