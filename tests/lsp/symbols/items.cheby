// @requests: documentSymbol
//! The outline holds every item, with variants, fields and interface functions as children.

/// Adds two numbers.
pub fn add(a: Int, b: Int) -> Int {
  a + b
}

@deprecated("use add")
pub fn plus(a: Int, b: Int) -> Int {
  add(a, b)
}

pub type Shape {
  Dot,
  Circle(Float),
  Rect { width: Float, height: Float },
}

pub type Point {
  x: Int,
  y: Int,
}

pub type Pair = (Int, Int)

pub const limit: Int = 10

pub interface Describe {
  fn describe(Self) -> String
  fn tag(Self) -> Int
}

fn main() {
  fn local() -> Int {
    1
  }
  assert local() == 1
}

test "add works" {
  assert add(1, 2) == 3
}
