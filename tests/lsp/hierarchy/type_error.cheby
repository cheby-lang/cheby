// @decisions: D-1379
//! A type error leaves the call hierarchy's items as they are.

type V {
  n: Int,
}

fn add(a: V, b: V) -> V {
  V { n: a.n + b.n }
}

fn even(n: Int) -> Bool {
  case n {
    0 => True
    _ => odd(n - 1)
  }
}

fn odd(n: Int) -> Bool {
  case n {
    0 => False
    _ => even(n - 1)
    //   ^ prepareCallHierarchy
  }
}

fn answer() -> Int {
  "forty-two"
}

fn main() {
  assert even(answer())
  //          ^ prepareCallHierarchy
  assert add(V { n: 1 }, V { n: 2 }).n == 3
  //> 22:10 incomingCalls
  //> 32:10 outgoingCalls
}
