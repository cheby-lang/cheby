// @decisions: D-1379
//! A file with a grammar error still prepares the functions its tree holds.

type V {
  n: Int,
}

fn add(a: V, b: V) -> V {
  V { n: a.n + b.n }
}

fn even(n: Int) -> Bool {
  case n {
    0 => True
    _ => odd(n - 1)
  }
}

fn odd(n: Int) -> Bool {
  case n {
    0 => False
    _ => even(n - 1)
    //   ^ prepareCallHierarchy
  }
}

fn first() -> Bool {
  even(add(V { n: 1 }, V { n: 2 }).n)
  //^ prepareCallHierarchy
  //> 22:10 incomingCalls
  //> 28:3 outgoingCalls
}

fn main() {
  assert first()
  let pair = (1,
}
