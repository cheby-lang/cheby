// @decisions: D-1509, D-1349
// @steps: idle
//! A constant whose initializer divides by zero. After `cheby/idle`, the
//! constants child's E0075 is published with its label and the note that
//! says why the evaluation panicked.

import std::io

const base: Int = 1 / 0

fn main() {
  io::println("base: {base}")
}
