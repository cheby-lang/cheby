// @decisions: D-1353
//! References in a file that does not parse: the uses its tree still
//! holds are found.

type Point {
  x: Int,
  y: Int,
}

fn add(a: Point, b: Point) -> Point {
  Point { x: a.x + b.x, y: a.y + b.y }
}

fn main() {
  let p = Point { x: 1, y: 2 }
  //  ^ references
  let q = p + p
  //        ^ references
  let pair = (q.x,
}
