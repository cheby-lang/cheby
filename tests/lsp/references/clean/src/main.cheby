// @decisions: D-1353
//! References across modules: a function, with the `+` that calls it,
//! a field through a record, a read, a pattern and `{q.x}`, and locals
//! with `{x}`.

import refs::shapes
import refs::shapes::{Point}

fn main() {
  let p = Point { x: 1, y: 2 }
  let q = shapes::add(p, p) + p
  //  ^ references
  let Point { x, y } = q
  let shown = "{x} {q.x}"
  //            ^ references
  //            ^ references noDeclaration
  assert shown == "3 3" && y == 6
}
