// @decisions: D-1353
//! References in a body with a type error: the uses around the error
//! are found.

type Point {
  x: Int,
  y: Int,
}

fn add(a: Point, b: Point) -> Point {
  Point { x: a.x + b.x, y: a.y + b.y }
}

fn main() {
  let p = Point { x: 1, y: 2 }
  //  ^ references
  let n: Int = p
  let q = p + p
  //        ^ references
  assert q.x == n
  //       ^ references
}
