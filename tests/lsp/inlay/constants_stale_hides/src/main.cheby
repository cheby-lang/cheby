// @decisions: D-1679, D-1510
// @settings: {"inlayHints": {"constants": true}}
// @steps: idle, edit dirty
// @requests: inlayHint
//! A run gives both constants their values, then `util` is edited and
//! left unsaved. `scaled` reaches `util` through `util::triple`, so its
//! value is no longer current and its hint is gone. `doubled` reaches
//! only this module, so its hint stays (D-1679, D-1510).

import app::util

const plain: Int = 20

const doubled: Int = plain * 2

const scaled: Int = util::triple(plain)

fn main() {
  assert scaled > doubled
}
