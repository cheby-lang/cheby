//! In a std checkout E0042's std row reads the checkout's items: an item
//! that only the checkout has, in another probe, is found and imported
//! (D-1726), as in a package (D-1706).

import std::list

/// One.
pub fn one() -> Int {
  list::only_in_the_checkout()
}
