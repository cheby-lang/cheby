// @decisions: D-1669, D-1391
// @client: empty
//! A client with neither `documentChanges` nor change annotations gets a
//! `changes` map with no version (D-1669), and a rename's note only as a
//! `window/showMessage` (D-1391).

interface Area {
  fn area(Self) -> Int
}

type Square {
  Square(Int),
}

fn area(s: Square) -> Int {
// ^ rename size
  let Square(side) = s
  side * side
}

fn main() {
  let squared = area(Square(2))
  //  ^ rename area2
  assert squared == 4
}
