// @decisions: D-1391, D-1671
//! A function whose satisfaction the package uses: `total` needs
//! `Square: Area`, so renaming `area` is refused, naming the interface.

interface Area {
  fn area(Self) -> Int
}

type Square {
  Square(Int),
}

fn area(s: Square) -> Int {
// ^ rename size
  let Square(side) = s
  side * side
}

fn total<T: Area>(x: T) -> Int {
  Area::area(x)
}

fn main() {
  assert total(Square(2)) == 4
}
