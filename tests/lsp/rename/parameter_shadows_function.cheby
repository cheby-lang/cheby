// @decisions: D-1579, D-1389, D-1671, D-1709
//! A parameter renamed to the name of a function of its module would
//! shadow it, which is E0044 (D-1579), so the rename is refused.

fn key() -> Int {
  1
}

fn get(what: Int) -> Int {
//     ^ rename key
  what + key()
}

fn main() {
  assert get(1) == 2
}
