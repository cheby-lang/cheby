// @decisions: D-1391
//! A function whose satisfaction nothing uses is renamed with a note. The
//! `standard` client takes annotations but does not honor them in rename,
//! so the note is also a `window/showMessage`.

interface Area {
  fn area(Self) -> Int
}

type Square {
  Square(Int),
}

fn area(s: Square) -> Int {
// ^ rename size
  let Square(side) = s
  side * side
}

fn main() {
  assert area(Square(2)) == 4
}
