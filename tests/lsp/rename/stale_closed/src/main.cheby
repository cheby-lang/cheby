//! test `a_stale_rename_sweeps_the_package` shows. Its new text adds a use of
//! `helper` and no diagnostic, so the published lists do not depend on
//! when the sweep's run lands.

import app::util

fn main() {
  assert util::helper() == 1
  //           ^ rename assist
}
