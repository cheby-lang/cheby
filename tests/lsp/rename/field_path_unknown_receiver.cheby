// @decisions: D-1390, D-1645
//! A field rename is refused when a step of a path has a receiver whose
//! type is unknown: here the update names a type that does not exist, so
//! neither `origin` nor `y` there can be told apart from another field.

type Point {
  x: Int,
  y: Int,
  //> 8:3 rename depth
}

type Shape {
  origin: Point,
  //> 13:3 rename base
  size: Int,
}

fn lift(shape: Shape) -> Shape {
  Shap { ..shape, origin.y: 1 }
}

fn main() {
  let shape = Shape { origin: Point { x: 0, y: 0 }, size: 1 }
  assert lift(shape).origin.y == 1
}
