// @decisions: D-1489
// @settings: {"analysis": {"target": "native"}}
// @steps: idle
//! An `Int` outside the JS range in a package that targets `native` and
//! `js`, with `analysis.target` set to `native`. The constants child
//! checks for that target, as `cheby check --target native` does, so no
//! E0078 is published and the value reaches hover (D-1489, D-540).
//! `no_target_gives_e0078` is the same package with the setting unset.

const big: Int = 9_007_199_254_740_991 * 2
//    ^ hover

fn main() {
  assert big > 0
}
