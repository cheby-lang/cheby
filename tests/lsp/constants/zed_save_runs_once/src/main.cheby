// @decisions: D-1494
// @settings: {"constants": {"childTimeoutSeconds": 600}}
// @steps: idle, zed-save next, started, zed-save next, quiet
//! A save as Zed 1.27 sends it: a watched change of the file, `didSave` a
//! few milliseconds later, and `didSave` again. The first save makes
//! `slow` take some seconds, and its burst starts one run. The same save
//! sent again while that child runs, as Zed's echo of its own write is,
//! leaves the child running, so no second run begins (`quiet`), and the
//! saved value reaches hover (D-1494).

const slow: Int = count_up(0, 10)

fn count_up(n: Int, limit: Int) -> Int {
  case {
    n >= limit => n
    _ => count_up(n + 1, limit)
  }
}

fn main() {
  assert slow > 0
}
