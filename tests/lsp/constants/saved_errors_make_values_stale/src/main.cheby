// @decisions: D-1501, D-1503
// @steps: idle, save broken, idle
//! A package whose constants ran, then a save that leaves a type error in
//! this file on disk, so no run starts. `util` has not changed, but its
//! constant's value may depend on this file, so hover shows it as of the
//! last save, as after a run the child skips (D-1503), not as current.

import app::util

const limit: Int = 20

fn main() {
  assert limit > util::base
}
