//! `panic_gives_e0075` in a file whose lines end with a carriage return
//! and a line feed. The child's ranges are in normalized text (D-1412),
//! so E0075 lands where it does with line feeds alone, and its hash still
//! matches the open document's.

import std::io

const ratio: Int = 100 / parts()
//    ^ hover

fn parts() -> Int {
  0
}

fn main() {
  io::println("main ran: {ratio}")
}
