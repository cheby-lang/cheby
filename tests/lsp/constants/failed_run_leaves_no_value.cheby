// @decisions: D-1490, D-1492
// @steps: idle
//! A constant beside one that panics. Evaluation fails, so it has no
//! value, not even a stale one, and saving cannot give it one until the
//! failure is fixed: hover says it is not evaluated, not that a save
//! computes it (D-1490).

const a: Int = 1
//    ^ hover

const ratio: Int = 100 / parts()
//    ^ hover

fn parts() -> Int {
  0
}

fn main() {
  assert a + ratio > 0
}
