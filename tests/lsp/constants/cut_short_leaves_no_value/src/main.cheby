// @decisions: D-1490
// @settings: {"constants": {"childTimeoutSeconds": 1}}
// @steps: idle
//! A constant that never ends, under a limit of 1 s, beside one that would
//! give a value. The server cuts the run short, so neither has a value,
//! and hover says they are not evaluated, not that a save computes them
//! (D-1490).

const a: Int = 1
//    ^ hover

const spin: Int = count_up(0)
//    ^ hover

fn count_up(n: Int) -> Int {
  count_up(n + 1)
}

fn main() {
  assert a + spin > 0
}
