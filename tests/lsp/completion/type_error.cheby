// @decisions: D-1376, D-1383, D-1384
// @settings: {"completion": {"autoImport": false}}
//! Completion in a body with a type error: the facts of the rest of the
//! body hold, and a local of the expected type ranks first.

fn need(n: Int) -> Int {
  n
}

fn main() {
  let count = 3
  let name = "three"
  let wrong: Int = name
  //                 ^ completion
  let fine = need(count)
  //                 ^ completion
  assert wrong == fine
}
