// @decisions: D-1645
//! After `.` in a record update's field path: the fields of the type of
//! the name before it, as after `x.`, with no pipe forms.

type Point {
  x: Int,
  y: Int,
}

type Player {
  position: Point,
  moves: Int,
}

type Game {
  player: Player,
  turn: Int,
}

fn step(game: Game) -> Game {
  Game { ..game, player.position.x: 1 }
  //                             ^ completion
  //                    ^ completion
}

fn main() {
  let game = Game { player: Player { position: Point { x: 0, y: 0 }, moves: 0 }, turn: 0 }
  let next = Game { ..step(game), player. }
  //                                     ^ completion
  assert next.turn == 0
}
