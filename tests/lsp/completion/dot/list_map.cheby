// @decisions: D-1394, D-244, D-245
//! `xs.ma` on a `List`, with `std::list` imported: the pipe form replaces
//! only `.ma`, with the hole at the list's parameter (type error state).

import std::list

fn main() {
  let xs = [1, 2, 3]
  let ys = xs.ma
  //            ^ completion map fold length
  //            ^ apply map
  assert ys == xs
}
