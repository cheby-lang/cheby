// @decisions: D-1376, D-1381, D-1383
//! `need(1, ` followed by a `let`: the `let` is kept (D-1381), the second
//! parameter's type ranks first, and a type error elsewhere changes
//! nothing.

fn need(n: Int, label: String) -> Int {
  n
}

fn main() {
  let count = 3
  let name = "three"
  let wrong: Int = name
  need(1, 
  //      ^ completion
  let after = count
  assert after == wrong
}
