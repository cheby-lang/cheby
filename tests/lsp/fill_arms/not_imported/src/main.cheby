// @decisions: D-1387, D-260, D-1692, D-1736
//! A `case` on a type that arrives through a signature, from a module the
//! file does not import, cannot name its constructors, so it gets one `_`
//! arm (X §6.4, D-260).

import app::make

fn main() {
  let n = case make::make_shape() {
  //           ^ action Add the missing arms
    _ when False => 0
  }
  assert n == 0
}
