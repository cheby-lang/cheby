// @decisions: D-1478
//! Declaration of a function that provides `show` is its definition,
//! since the builtin `Show` has no source: at its name, at a call and
//! at the braces of `{p}`, which call it.

type Point {
  x: Int,
  y: Int,
}

/// Shows a point.
fn show(p: Point) -> String {
  //> 12:4 declaration
  "({p.x}, {p.y})"
}

fn main() {
  let p = Point { x: 1, y: 2 }
  let text = show(p)
  //         ^ declaration
  assert "{p}" == text
  //      ^ declaration
}
