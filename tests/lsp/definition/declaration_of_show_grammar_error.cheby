// @decisions: D-1478
//! Declaration of a function that provides `show`, in a file that does
//! not parse: still its definition, at its name and at a call the tree
//! still holds.

type Point {
  x: Int,
  y: Int,
}

/// Shows a point.
fn show(p: Point) -> String {
  //> 12:4 declaration
  "({p.x}, {p.y})"
}

fn main() {
  let p = Point { x: 1, y: 2 }
  let text = show(p)
  //         ^ declaration
  let pair = (text,
}
