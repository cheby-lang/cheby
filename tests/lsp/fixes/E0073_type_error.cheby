// @decisions: D-1388, D-1393, D-140
//! E0073's help asserts a `Bool` test body.
//! With a type error in another function, which stays.

fn double(n: Int) -> Int {
  n * 2
}

test "double doubles" {
  double(2) == 4
}

fn main() {
  assert double(1) == 2
}

pub fn answer() -> Int {
  "forty-two"
}
//> 10:3 action Add `assert`
