// @decisions: D-1353, D-1388, D-1393, D-1736, D-1749
//! A method call that is an operand becomes the call form, as completion
//! writes it (X §4.2).
//! With a type error in another function.

import std::list

fn size(xs: List<Int>) -> Int {
  xs.length() + 1
}

fn main() {
  assert size([1]) == 2
}

fn answer() -> Int {
  "forty-two"
}
//> 9:6 action Write `list::length(xs)`
