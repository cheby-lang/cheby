// @decisions: D-1696, D-1735, D-1736, D-164, D-1745
//! E0063 reached through a tuple's element: the stub goes to the element's
//! type, at the end of the chain.
//! With a type error in another function.

type Point {
  x: Int,
}

fn main() {
  let pair = (1, Point { x: 1 })
  assert "{pair}" == "(1, 1)"
  //       ^ action Add the missing function `show`
}

fn broken() -> Int {
  "not a number"
}
