// @decisions: D-1353, D-1388, D-1393, D-1736, D-1749
//! A method call that is an operand becomes the call form, as completion
//! writes it (X §4.2).
//! With a grammar error in another function, only the token checks
//! run, so E0058 is not reported and no fix is offered (D-425).

import std::list

fn size(xs: List<Int>) -> Int {
  xs.length() + 1
}

fn main() {
  assert size([1]) == 2
}

fn broken() {
  let = 1
}
//> 10:6 noAction Write `list::length(xs)`
