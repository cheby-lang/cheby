// @decisions: D-1388, D-1393, D-165, D-425
//! E0023's help removes the type arguments of an interface function.
//! With a grammar error in another function, only the token checks
//! run, so the code is not reported and no fix is offered (D-425).

fn label(n: Int) -> String {
  Show::show::<Int>(n)
}

fn main() {
  assert label(1) == "1"
}

fn broken() {
  let = 1
}
//> 7:13 noAction remove the type arguments
