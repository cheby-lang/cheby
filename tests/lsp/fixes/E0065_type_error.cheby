// @decisions: D-1388, D-1393, D-1736, D-236, D-166
//! E0065's fix bounds the type parameter that has no descriptor.
//! With a type error in another function, which stays.

interface Any

fn wrap<T>(xs: List<T>) -> dyn Any {
  xs
}

fn main() {
  let _ = wrap([1])
}

pub fn answer() -> Int {
  "forty-two"
}
//> 8:3 action Add bound `T: Any`
