// @decisions: D-1388, D-1393, D-109, D-425
//! E0035's help adds a final `_` arm to a subjectless `case`.
//! With a grammar error in another function, only the token checks
//! run, so the code is not reported and no fix is offered (D-425).

fn sign(n: Int) -> Int {
  case {
    n > 0 => 1
    n < 0 => -1
  }
}

fn main() {
  assert sign(2) == 1
}

fn broken() {
  let = 1
}
//> 9:5 noAction add a final arm `_ => …` for the remaining cases (D-109)
