// @decisions: D-1388, D-1393, D-1953
//! W0014: the fix puts the imports in `cheby fmt`'s order, each with the
//! comments that travel with it, beside a type error in another function,
//! which stays.

import std::list // lists
// For `int::show`.
import std::int
import std::io

fn main() {
  io::println(int::show(list::length([1])))
}

fn answer() -> Int {
  "forty-two"
}
//> 6:1 action put the imports in order, as `cheby fmt` does
