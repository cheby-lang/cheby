// @decisions: D-1388, D-1393, D-1668, D-1735, D-1736
//! E0044's fix renames the second binding and its later uses to a free
//! name with rename's writer, and is checked as a rename is (D-1735).
//! With a grammar error in another function, only the token checks
//! run, so E0044 is not reported and no fix is offered (D-425).

fn total(a: Int) -> Int {
  let sum = a
  let sum = sum + 1
  sum * 2
}

fn main() {
  assert total(1) == 4
}

fn broken() {
  let = 1
}
//> 9:7 noAction Rename `sum` to `sum_2`
