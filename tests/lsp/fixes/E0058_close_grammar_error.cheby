// @decisions: D-1388, D-1393, D-1736, D-071, D-1347
//! E0058's fix writes the field of the type closest to the one written.
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

type Point {
  x: Int,
  y: Int,
}

fn depth(p: Point) -> Int {
  p.yy
}

fn main() {
  assert depth(Point { x: 0, y: 0 }) == 0
}

fn broken() {
  let = 1
}
//> 12:5 noAction Use the field `y`
