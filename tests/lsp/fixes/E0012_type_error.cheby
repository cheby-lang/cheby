// @decisions: D-1388, D-1393, D-115
// @newErrors: E0047
//! E0012's help removes the whitespace inside an interpolation.
//! With a type error in another function, which the fix reveals.

fn main() {
  let name = "x"
  let s = "{ name}"
  assert s == "x"
}

fn answer() -> Int {
  "forty-two"
}
//> 8:13 action remove the whitespace (D-115)
