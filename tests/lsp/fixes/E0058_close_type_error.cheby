// @decisions: D-1388, D-1393, D-1736, D-071
//! E0058's fix writes the field of the type closest to the one written.
//! With a type error in another function, which stays.

type Point {
  x: Int,
  y: Int,
}

fn depth(p: Point) -> Int {
  p.yy
}

fn main() {
  assert depth(Point { x: 0, y: 0 }) == 0
}

pub fn answer() -> Int {
  "forty-two"
}
//> 11:5 action Use the field `y`
