// @decisions: D-1388, D-1393, D-470
// @newErrors: E0047
//! E0056's help removes the space of a negative literal.
//! With a type error in another function, which the fix reveals.

fn main() {
  let low = - 128
  assert low == -128
}

fn answer() -> Int {
  "forty-two"
}
//> 7:14 action remove the space
