// @decisions: D-1388, D-1393, D-1694, D-1657
// @newErrors: E0047
//! D-1657's help writes `.._` in a list pattern as `..`, titled "Write
//! `..`".
//! With a type error in another function, which the fix reveals.

fn first(xs: List<Int>) -> Int {
  case xs {
    [x, .._] => x
    [] => 0
  }
}

fn main() {
  assert first([1]) == 1
}

pub fn answer() -> Int {
  "forty-two"
}
//> 9:11 action Write `..`
