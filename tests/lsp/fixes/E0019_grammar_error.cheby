// @decisions: D-1388, D-1393, D-200, D-425
//! E0019's help removes the space between `@` and an attribute's name.
//! With a grammar error in another function, only the token checks
//! run, so the code is not reported and no fix is offered (D-425).

@ deprecated("use g")
pub fn f() -> Int {
  1
}

fn main() {
  assert f() == 1
}

fn broken() {
  let = 1
}
//> 6:2 noAction remove the space
