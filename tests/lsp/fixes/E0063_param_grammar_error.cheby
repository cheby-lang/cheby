// @decisions: D-1736, D-1347
//! With a grammar error in another function E0063 is not reported
//! (D-1347), so neither fix is offered.

fn label<T>(x: T) -> String {
  "{x}"
  //^ noAction Add bound `T: Show`
  //^ noAction Use debug printing `{x:?}`
}

fn main() {
  assert label(1) == "1"
}

fn broken() {
  let = 1
}
