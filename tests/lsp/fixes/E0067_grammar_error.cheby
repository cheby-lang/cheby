// @decisions: D-1388, D-1393, D-1736, D-056, D-141, D-1347
//! E0067's fixes restrict the using item, or the module, to the one
//! target the used item exists on.
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

@external(js, "./clock.mjs", "now")
fn js_now() -> Int

fn main() {
  let _ = js_now()
}

fn broken() {
  let = 1
}
