// @decisions: D-1388, D-1393, D-1736, D-138
//! E0059's fixes add the missing fields as `todo`, or remove a field
//! written twice.
//! With a type error in another function, which stays.

type Point {
  x: Int,
  y: Int,
}

fn origin() -> Point {
  Point { x: 0 }
}

fn other() -> Point {
  Point { x: 0, y: 1, x: 2 }
}

fn main() {
  assert origin().x == other().x
}

pub fn answer() -> Int {
  "forty-two"
}
//> 12:3 action Add the missing fields as `todo`
//> 16:23 action Remove the field `x`
