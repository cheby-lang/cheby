// @decisions: D-1388, D-1393, D-437
//! E0013's help removes the empty parentheses of a constructor pattern.

type Light {
  Off,
  On,
}

fn lit(light: Light) -> Bool {
  case light {
    Off() => False
    On => True
  }
}

fn main() {
  assert lit(On)
}
//> 11:8 action for a constructor without fields, remove the parentheses
