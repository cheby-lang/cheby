// @decisions: D-1388, D-1393, D-150, D-425
//! E0022's help makes an `exposed` type `pub` as well.
//! With a grammar error in another function, only the token checks
//! run, so the code is not reported and no fix is offered (D-425).

exposed type Point {
  x: Int,
  y: Int,
}

fn main() {
  let p = Point { x: 1, y: 2 }
  assert p.x + p.y == 3
}

fn broken() {
  let = 1
}
//> 6:1 noAction make the type `pub` as well
