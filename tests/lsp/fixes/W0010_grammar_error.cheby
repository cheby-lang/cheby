// @decisions: D-1388, D-1393, D-1736, D-1687, D-022, D-1347
//! W0010's fix removes the arm that can never match, found by its span.
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

fn sign(n: Int) -> Int {
  case n {
    _ => 0
    1 => 1
  }
}

fn main() {
  assert sign(1) == 0
}

fn broken() {
  let = 1
}
//> 9:5 noAction Remove the arm
