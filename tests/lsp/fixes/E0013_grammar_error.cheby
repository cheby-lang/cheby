// @decisions: D-1388, D-1393, D-437, D-425
//! E0013's help removes the empty parentheses of a constructor pattern.
//! With a grammar error in another function, only the token checks
//! run, so the code is not reported and no fix is offered (D-425).

type Light {
  Off,
  On,
}

fn lit(light: Light) -> Bool {
  case light {
    Off() => False
    On => True
  }
}

fn main() {
  assert lit(On)
}

fn broken() {
  let = 1
}
//> 13:8 noAction for a constructor without fields, remove the parentheses
