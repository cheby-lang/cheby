// @decisions: D-1388, D-1393, D-245, D-425
//! E0027's help writes the callee of a call whose only argument is `_`.
//! With a grammar error in another function, only the token checks
//! run, so the code is not reported and no fix is offered (D-425).

fn double(n: Int) -> Int {
  n * 2
}

fn main() {
  let f = double(_)
  assert f(2) == 4
}

fn broken() {
  let = 1
}
//> 11:11 noAction write `double` instead
