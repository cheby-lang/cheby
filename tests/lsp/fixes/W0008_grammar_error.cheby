// @decisions: D-1388, D-1393, D-1736, D-159, D-1341, D-1347
//! W0008's fixes write a plain `let` for a `let assert` or a `let guard`
//! whose pattern always matches.
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

fn sum(pair: (Int, Int)) -> Int {
  let assert (a, b) = pair
  let guard (c, d) = pair else {
    0
  }
  a + b + c + d
}

fn main() {
  assert sum((1, 2)) == 6
}

fn broken() {
  let = 1
}
//> 8:14 noAction Write `let (a, b)`
//> 9:13 noAction Drop the `else`
