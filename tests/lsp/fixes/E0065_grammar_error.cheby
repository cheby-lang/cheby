// @decisions: D-1388, D-1393, D-1736, D-236, D-166, D-1347
//! E0065's fix bounds the type parameter that has no descriptor.
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

interface Any

fn wrap<T>(xs: List<T>) -> dyn Any {
  xs
}

fn main() {
  let _ = wrap([1])
}

fn broken() {
  let = 1
}
//> 9:3 noAction Add bound `T: Any`
