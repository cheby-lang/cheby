//! E0063's stubs with a type error in another function.

interface Area {
  fn area(Self) -> Float
  fn scale(Self, Float) -> Self
}

type Square {
  side: Float,
}

fn measure<T: Area>(x: T) -> Float {
  Area::area(x)
}

fn main() {
  let square = Square { side: 1.0 }
  assert measure(square) == 1.0
  //             ^ codeAction
  //             ^ action Add all missing functions
}

fn broken() -> Int {
  "not a number"
}
