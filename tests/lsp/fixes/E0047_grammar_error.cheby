// @decisions: D-1388, D-1393, D-1736, D-011, D-1347
//! E0047's fix wraps a value in the constructor whose payload is its type
//! (X §6.2.1).
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

fn first(n: Int) -> Option<Int> {
  n
}

fn parse(s: String) -> Result<Int, String> {
  s
}

fn main() {
  assert first(1) == Some(1)
  assert parse("x") == Err("x")
}

fn broken() {
  let = 1
}

pub fn wrap(n: Int) -> Result<Int, String> {
  n
}
//> 8:3 noAction Wrap in `Some(…)`
//> 12:3 noAction Wrap in `Err(…)`
//> 25:3 noAction Wrap in `Ok(…)`
