// @decisions: D-1388, D-1393, D-1736, D-138, D-1347
//! E0059's fixes add the missing fields as `todo`, or remove a field
//! written twice.
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

type Point {
  x: Int,
  y: Int,
}

fn origin() -> Point {
  Point { x: 0 }
}

fn other() -> Point {
  Point { x: 0, y: 1, x: 2 }
}

fn main() {
  assert origin().x == other().x
}

fn broken() {
  let = 1
}
//> 13:3 noAction Add the missing fields as `todo`
//> 17:23 noAction Remove the field `x`
