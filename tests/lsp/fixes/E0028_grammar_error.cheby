// @decisions: D-1388, D-1393, D-244, D-425
//! E0028's help adds the `_` where the piped value goes.
//! With a grammar error in another function, only the token checks
//! run, so the code is not reported and no fix is offered (D-425).

import std::list

fn double(n: Int) -> Int {
  n * 2
}

fn main() {
  let xs = [1, 2] |> list::map(double)
  assert xs == [2, 4]
}

fn broken() {
  let = 1
}
//> 13:22 noAction add `_` where the piped value goes
