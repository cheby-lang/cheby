// @decisions: D-1388, D-1393, D-244
// @newErrors: E0047
//! E0028's help adds the `_` where the piped value goes.
//! With a type error in another function, which the fix reveals.

import std::list

fn double(n: Int) -> Int {
  n * 2
}

fn main() {
  let xs = [1, 2] |> list::map(double)
  assert xs == [2, 4]
}

fn answer() -> Int {
  "forty-two"
}
//> 13:22 action add `_` where the piped value goes
