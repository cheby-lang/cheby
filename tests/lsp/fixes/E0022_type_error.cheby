// @decisions: D-1388, D-1393, D-150
// @newErrors: E0047
//! E0022's help makes an `exposed` type `pub` as well.
//! With a type error in another function, which the fix reveals.

exposed type Point {
  x: Int,
  y: Int,
}

fn main() {
  let p = Point { x: 1, y: 2 }
  assert p.x + p.y == 3
}

fn answer() -> Int {
  "forty-two"
}
//> 6:1 action make the type `pub` as well
