// @decisions: D-1388, D-1393, D-1736, D-063, D-462, D-1347
//! E0052's fix writes `dyn` before an interface named as a type.
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

pub interface Describe {
  fn describe(Self) -> String
}

pub fn label(item: Describe) -> String {
  Describe::describe(item)
}

fn broken() {
  let = 1
}
//> 10:20 noAction Write `dyn Describe`
