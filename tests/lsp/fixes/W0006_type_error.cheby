// @decisions: D-1388, D-1393, D-1736, D-153
//! W0006's fix discards a `Result` with `let _ =`, under its own title.
//! With a type error in another function, which stays.

fn parse(text: String) -> Result<Int, String> {
  case text {
    "1" => Ok(1)
    _ => Err(text)
  }
}

fn main() {
  parse("1")
  assert 1 == 1
}

pub fn answer() -> Int {
  "forty-two"
}
//> 13:3 action Discard the value with `let _ =`
