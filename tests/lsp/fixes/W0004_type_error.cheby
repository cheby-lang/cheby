//! W0004's fix removes an unused `priv` item with its doc comment.
//! With a type error in another function, not every body of the module
//! type-checked, so the code is not reported and no fix is offered (D-516).

fn main() {
  assert 1 == 1
}

/// Doubles.
priv fn twice(n: Int) -> Int {
  n * 2
}

pub fn answer() -> Int {
  "forty-two"
}
