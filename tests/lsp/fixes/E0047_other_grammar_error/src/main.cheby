// @decisions: D-1347, D-1357, D-1360, D-1388, D-1393, D-1736
//! While another module never parsed (D-1357), the report of this one is
//! substituted: E0047's and E0059's fixes are applied under it, and
//! W0004's removal is not offered (D-1360).

type Point {
  x: Int,
  y: Int,
}

fn first(n: Int) -> Option<Int> {
  n
}

fn origin() -> Point {
  Point { x: 0 }
}

/// Doubles.
priv fn twice(n: Int) -> Int {
  n * 2
}

fn main() {
  assert first(1) == Some(1)
  assert origin().x == 0
}
