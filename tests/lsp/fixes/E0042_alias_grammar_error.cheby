// @decisions: D-1388, D-1393, D-1736, D-1743, D-1347
//! E0042 on a module that is imported under another name: the fix writes
//! the qualifier as the import names it.
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

import std::list as l

fn main() {
  assert list::length([1, 2]) == 2
}

fn broken() {
  let = 1
}
//> 10:10 noAction Use `l::length`
