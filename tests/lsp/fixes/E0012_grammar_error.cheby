// @decisions: D-1388, D-1393, D-115
//! E0012's help removes the whitespace inside an interpolation.
//! With a grammar error in another function, which stays.

fn main() {
  let name = "x"
  let s = "{ name}"
  assert s == "x"
}

fn broken() {
  let = 1
}
