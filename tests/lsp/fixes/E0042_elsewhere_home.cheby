// @decisions: D-1388, D-1393, D-447, D-1658, D-1694, D-1736
//! E0042's std row for a builtin type that a module of std homes: the fix
//! names it through its home, `std::option` (D-447, D-1694).

import std::list

fn first(xs: List<Int>) -> list::Option<Int> {
  list::first(xs)
}

fn main() {
  assert first([1]) == Some(1)
}
//> 7:34 action Use `option::Option` and import `std::option`
