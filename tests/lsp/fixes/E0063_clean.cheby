// @decisions: D-1696, D-1735, D-1736, D-164, D-083
//! E0063 for a missing function: a stub for each function the type's
//! module lacks, and "Add all missing functions", after the type's
//! declaration, with `Self` as the type and `-> Nil` left out (X §6.6).

interface Area {
  fn area(Self) -> Float
  fn scale(Self, Float) -> Self
}

type Square {
  side: Float,
}

fn measure<T: Area>(x: T) -> Float {
  Area::area(x)
}

fn main() {
  let square = Square { side: 1.0 }
  assert measure(square) == 1.0
  //             ^ codeAction
  //             ^ action Add all missing functions
}
