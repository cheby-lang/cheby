// @decisions: D-1388, D-1393, D-1694, D-1661
// @newErrors: E0047
//! D-1661's help writes a `{` that opens no interpolation as `\{`,
//! titled "Escape the brace as `\{`".
//! With a type error in another function, which the fix reveals.

fn main() {
  let amount = "3"
  let line = "price {" + amount + "}"
  assert line == line
}

pub fn answer() -> Int {
  "forty-two"
}
//> 9:22 action Escape the brace as `\{`
