//! ones, by the callee's parameters.
//! With a type error in another function, which stays.

fn add(a: Int, b: Int) -> Int {
  a + b
}

fn main() {
  let one = add(1)
  let three = add(1, 2, 3)
  assert one == three
}

pub fn answer() -> Int {
  "forty-two"
}
