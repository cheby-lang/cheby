// @decisions: D-1388, D-1393, D-1694, D-1657
//! D-1657's help writes `.._` in a list pattern as `..`, titled "Write
//! `..`".
//! With a grammar error in another function, which stays.

fn first(xs: List<Int>) -> Int {
  case xs {
    [x, .._] => x
    [] => 0
  }
}

fn main() {
  assert first([1]) == 1
}

fn broken() {
  let = 1
}
//> 8:11 action Write `..`
