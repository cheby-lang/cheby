// @decisions: D-1388, D-1393, D-1736, D-159, D-1341
//! W0008's fixes write a plain `let` for a `let assert` or a `let guard`
//! whose pattern always matches.

fn sum(pair: (Int, Int)) -> Int {
  let assert (a, b) = pair
  let guard (c, d) = pair else {
    0
  }
  a + b + c + d
}

fn main() {
  assert sum((1, 2)) == 6
}
//> 6:14 action Write `let (a, b)`
//> 7:13 action Drop the `else`
