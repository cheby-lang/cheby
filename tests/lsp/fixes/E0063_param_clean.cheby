// @decisions: D-1736, D-086
//! E0063 on a type parameter: a bound on the enclosing item's parameter,
//! and debug printing on the interpolation (X §6.6).

fn label<T>(x: T) -> String {
  "{x}"
  //^ action Add bound `T: Show`
  //^ action Use debug printing `{x:?}`
}

fn main() {
  assert label(1) == "1"
}
