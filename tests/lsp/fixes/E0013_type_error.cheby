// @decisions: D-1388, D-1393, D-437
// @newErrors: E0047
//! E0013's help removes the empty parentheses of a constructor pattern.
//! With a type error in another function, which the fix reveals.

type Light {
  Off,
  On,
}

fn lit(light: Light) -> Bool {
  case light {
    Off() => False
    On => True
  }
}

fn main() {
  assert lit(On)
}

fn answer() -> Int {
  "forty-two"
}
//> 13:8 action for a constructor without fields, remove the parentheses
