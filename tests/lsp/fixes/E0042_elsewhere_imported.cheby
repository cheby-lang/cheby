// @decisions: D-1388, D-1393, D-1658, D-1694, D-1736
//! E0042's std row where the file already imports the item's module: the
//! fix only writes the item, through the import's name (D-1694).

import std::file
import std::io as std_io

fn main() {
  case file::read_text("notes.txt") {
    Ok(text) => std_io::println(text)
    Err(_) => std_io::println("none")
  }
}
//> 9:14 action Use `std_io::read_file`
