// @decisions: D-1388, D-1393, D-1736, D-050, D-1347
//! E0048's fixes add the missing arguments as `todo` or remove the extra
//! ones, by the callee's parameters.
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

fn add(a: Int, b: Int) -> Int {
  a + b
}

fn main() {
  let one = add(1)
  let three = add(1, 2, 3)
  assert one == three
}

fn broken() {
  let = 1
}
