// @decisions: D-1353, D-1388, D-1393, D-1736, D-1749
//! A method call whose home module the file does not import becomes the
//! call form as an operand of `+`, as completion writes it, and the import
//! is added (X §6.5).

fn size(xs: List<Int>) -> Int {
  xs.length() + 1
}

fn main() {
  assert size([1]) == 2
}
//> 7:6 action Write `list::length(xs)`
