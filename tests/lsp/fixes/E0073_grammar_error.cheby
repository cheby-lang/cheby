// @decisions: D-1388, D-1393, D-140, D-1347
//! E0073's help asserts a `Bool` test body.
//! With a grammar error in another function, the run that would report
//! the code reads no text of the file, so no fix is offered (D-1347).

fn double(n: Int) -> Int {
  n * 2
}

test "double doubles" {
  double(2) == 4
}

fn main() {
  assert double(1) == 2
}

fn broken() {
  let = 1
}
//> 11:3 noAction Add `assert`
