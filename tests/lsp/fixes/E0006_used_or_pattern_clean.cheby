// @decisions: D-1388, D-1393, D-059, D-1668, D-1741
//! E0006's fix on a name bound in both alternatives of an or-pattern
//! renames it in both, and the E0006 of each declaration goes away.

type Shape {
  Circle(Int),
  Square(Int),
}

fn area(s: Shape) -> Int {
  case s {
    Circle(sideLen) | Square(sideLen) => sideLen * sideLen
    //                       ^ action write `side_len`
  }
}

fn main() {
  assert area(Circle(2)) == 4
}
