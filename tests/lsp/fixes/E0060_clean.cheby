// @decisions: D-1388, D-1393, D-1736, D-159, D-1341
//! E0060's fixes make a refutable `let` a `let assert` or a `let guard`.

fn get(o: Option<Int>) -> Int {
  let Some(x) = o
  x
}

fn main() {
  assert get(Some(1)) == 1
}
//> 5:7 action Use `let assert`
//> 5:7 action Use `let guard … else { todo }`
