// @decisions: D-1388, D-1393, D-200
// @newErrors: E0047
//! E0019's help removes the space between `@` and an attribute's name.
//! With a type error in another function, which the fix reveals.

@ deprecated("use g")
pub fn f() -> Int {
  1
}

fn main() {
  assert f() == 1
}

fn answer() -> Int {
  "forty-two"
}
//> 6:2 action remove the space
