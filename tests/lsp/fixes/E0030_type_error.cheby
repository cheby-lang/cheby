// @decisions: D-1388, D-1393, D-1689, D-076
// @newErrors: E0047
//! E0030's help writes a one-element tuple as its element.
//! With a type error in another function, which the fix reveals.

fn main() {
  let single = (1,)
  assert single == single
}

pub fn answer() -> Int {
  "forty-two"
}
//> 7:16 action write the value alone; `(e)` is just `e` in parentheses
