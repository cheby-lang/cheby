// @decisions: D-1388, D-1393, D-1694, D-1661
//! D-1661's help writes a `{` that opens no interpolation as `\{`,
//! titled "Escape the brace as `\{`".
//! With a grammar error in another function, which stays.

fn main() {
  let amount = "3"
  let line = "price {" + amount + "}"
  assert line == line
}

fn broken() {
  let = 1
}
//> 8:22 action Escape the brace as `\{`
