// @decisions: D-1696, D-1735, D-1736, D-164, D-1745, D-1347
//! E0063 reached through a tuple's element: the stub goes to the element's
//! type, at the end of the chain.
//! With a grammar error in another function E0063 is not reported
//! (D-1347), so no stub is offered.

type Point {
  x: Int,
}

fn main() {
  let pair = (1, Point { x: 1 })
  assert "{pair}" == "(1, 1)"
  //       ^ noAction Add the missing function `show`
}

fn broken() {
  let = 1
}
