// @decisions: D-1388, D-1393, D-245
// @newErrors: E0047
//! E0027's help writes the callee of a call whose only argument is `_`.
//! With a type error in another function, which the fix reveals.

fn double(n: Int) -> Int {
  n * 2
}

fn main() {
  let f = double(_)
  assert f(2) == 4
}

fn answer() -> Int {
  "forty-two"
}
//> 11:11 action write `double` instead
