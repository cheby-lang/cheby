// @decisions: D-1388, D-1393, D-1736, D-159, D-1341
//! E0060's fixes make a refutable `let` a `let assert` or a `let guard`.
//! With a type error in another function, which stays.

fn get(o: Option<Int>) -> Int {
  let Some(x) = o
  x
}

fn main() {
  assert get(Some(1)) == 1
}

pub fn answer() -> Int {
  "forty-two"
}
//> 6:7 action Use `let assert`
//> 6:7 action Use `let guard … else { todo }`
