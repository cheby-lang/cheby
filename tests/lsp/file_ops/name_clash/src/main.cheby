//! The root module, which imports `util`.

import moves::util
import moves::util::{greet}
import std::io

fn main() {
  let s: util::Shape = util::Shape(1)
  let _ = s
  io::println(util::greet())
  io::println(greet())
  let helpers = 2
  assert helpers == 2
}
