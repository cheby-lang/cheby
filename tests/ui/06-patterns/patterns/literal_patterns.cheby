// @mode: check-pass
// @decisions: D-113, D-470
//! Integer literal patterns, negative ones included, and string and raw
//! string patterns match equal values (§6.3).

fn http_reason(code: Int) -> String {
  case code {
    200 => "OK"
    404 => "Not Found"
    -1 => "unknown"
    _ => "other"
  }
}

fn command(word: String) -> Int {
  case word {
    "start" => 1
    r"\stop" => 2
    _ => 0
  }
}

fn small(n: U8) -> Bool {
  case n {
    0 | 255 => False
    _ => True
  }
}

fn main() {
  assert http_reason(-1) == "unknown"
  assert command("start") == 1
  assert small(1)
}
