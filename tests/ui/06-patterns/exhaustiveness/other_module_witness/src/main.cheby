// @mode: check-fail
// @decisions: D-022, D-463, D-507
//! A missing constructor of another module is written with its module,
//! as code here would name it.

import app::shape

fn describe(s: shape::Shape) -> String {
  case s {
    shape::Dot => "dot"
  }
}

fn main() {
  assert describe(shape::Dot) == "dot"
  assert describe(shape::Circle { radius: 1 }) == "dot"
}
