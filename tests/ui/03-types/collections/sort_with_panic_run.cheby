// @mode: run-fail
// @decisions: D-526, D-1447
//! A panic inside the comparison `list::sort_with` calls is reported like
//! any other panic: the runtime calls it back through a trampoline, so its
//! location is the panic's (§11).

import std::list

fn main() {
  let sorted = list::sort_with([3, 0, 2, 1], fn(a, b) {
    let ratio = 6 / a
    int_compare(ratio, b)
  })
  assert sorted == []
}

fn int_compare(a: Int, b: Int) -> Order {
  case {
    a < b => Less
    a > b => Greater
    _ => Equal
  }
}
