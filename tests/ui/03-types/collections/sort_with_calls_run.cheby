// @mode: run-pass
// @decisions: D-299, D-1448
//! `list::sort_with` merges runs of one element in adjacent pairs, front
//! to back, and compares the front elements of two runs, so a comparison
//! that prints sees the same calls in the same order on every target.

import std::int
import std::io
import std::list

fn main() {
  let sorted = list::sort_with([5, 3, 9, 1, 3, 7, 2], fn(a, b) {
    io::println("{a} {b}")
    int::compare(a, b)
  })
  io::println("{sorted:?}")
}
