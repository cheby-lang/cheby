// @mode: check-pass
// @decisions: D-084, D-470
//! A numeric literal may have any numeric type of its kind, and a negative
//! literal fits down to the type's minimum (§3.3.4, §5.3.1).

pub fn byte() -> U8 {
  255
}

pub fn small() -> I8 {
  -128
}

pub fn single() -> F32 {
  1.5
}

pub fn lowest() -> Int {
  -9223372036854775808
}

pub fn widest() -> U64 {
  18446744073709551615
}
