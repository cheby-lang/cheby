// @mode: run-pass
// @decisions: D-1901, D-1902, D-1903
//! A secret prints as `<redacted>` wherever text is made of it: in
//! `{x:?}` and `{x}`, through a bound and a `dyn` value, inside records,
//! variants, tuples and collections, with `io::debug`, and in the fields of
//! a log record (§3.13).

import std::heap
import std::io
import std::list
import std::log
import std::map
import std::ordered_map
import std::secret
import std::set

type Config {
  user: String,
  password: secret::Secret<String>,
  pins: List<secret::Secret<Int>>,
}

type Access {
  Token(secret::Secret<String>),
  Anonymous,
}

fn shown<T: Show>(value: T) -> String {
  "{value}"
}

fn debugged<T>(value: T) -> String {
  "{value:?}"
}

fn main() {
  let token = secret::new("hunter2")
  io::println("{token} {token:?}")
  let config = Config { user: "ada", password: token, pins: [secret::new(1), secret::new(2)] }
  io::println("{config:?}")
  io::println("{config.password}")
  let access = [Token(token), Anonymous]
  io::println("{access:?}")

  io::println(shown(token))
  io::println(shown([token, token]))
  io::println(shown(Some(token)))
  io::println(shown((token, 1)))
  let anything: dyn Show = token
  io::println("{anything} {anything:?}")
  io::println(debugged(config))

  let failed: Result<Int, secret::Secret<String>> = Err(token)
  io::println("{failed:?}")
  io::println(debugged(map::from_list([("a", token), ("b", secret::new("other"))])))
  io::println(debugged(map::from_list([(token, 1), (secret::new("other"), 1)])))
  io::println(debugged(set::from_list([token, secret::new("other"), secret::new("hunter2")])))
  io::println(debugged(ordered_map::from_list([("a", token)])))
  io::println(debugged(heap::new_min::<secret::Secret<String>>()))
  io::println(debugged(secret::new(secret::new("inner"))))
  io::println(debugged(secret::new(fn(x: Int) { x })))
  io::println(debugged(secret::new(Nil)))
  io::println(debugged(secret::new([0.5])))

  let same = io::debug(config)
  let _ = io::debug_as(same.password, "password")
  let (_, records) = log::capture(fn() {
    log::info_with("login", [log::field("shown", token), log::inspect("config", config)])
  })
  let fields = list::flat_map(records, fn(record) { record.fields })
  io::println("{fields:?}")
}
