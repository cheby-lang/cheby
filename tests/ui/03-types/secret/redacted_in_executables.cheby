// @mode: run-pass
// @command: build
// @milestone: M3
// @decisions: D-1902, D-1903, D-1904, D-1906
//! An executable prints, compares and hashes secrets as `cheby run` does,
//! also a secret in a constant (§3.13).

import std::io
import std::secret
import std::set

const key: secret::Secret<String> = secret::new("hunter2")

fn main() {
  let token = secret::new("hunter2")
  io::println("{token} {token:?} {key:?}")
  assert token == key
  assert set::size(set::from_list([token, key, secret::new("other")])) == 2
  io::println(secret::expose(key))
}
