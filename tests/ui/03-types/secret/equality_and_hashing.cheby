// @mode: run-pass
// @decisions: D-1904
//! Secrets are `==`, and hash alike, when their values are, for values of
//! any type, so a record with a secret field compares and is a map key
//! (§3.13).

import std::float
import std::io
import std::map
import std::secret
import std::set
import std::sorted_set

type Login {
  user: String,
  password: secret::Secret<String>,
}

fn login(password: String) -> Login {
  Login { user: "ada", password: secret::new(password) }
}

fn main() {
  assert login("a") == login("a")
  assert login("a") != login("b")
  assert secret::new(1) == secret::new(1)
  assert secret::new(1) != secret::new(2)
  assert secret::new(float::nan) == secret::new(float::nan)
  assert secret::new(0.0) == secret::new(-0.0)
  assert secret::new(Nil) == secret::new(Nil)
  assert secret::new([Some("a")]) == secret::new([Some("a")])
  assert secret::new(secret::new(1)) != secret::new(secret::new(2))
  let grown = sorted_set::insert(sorted_set::from_list([2, 3]), 1)
  assert secret::new(grown) == secret::new(sorted_set::from_list([3, 2, 1]))

  let ages = map::from_list([(login("a"), 1), (login("b"), 2)])
  assert map::get(ages, login("b")) == Some(2)
  assert map::get(ages, login("c")) == None
  assert set::size(set::from_list([secret::new(1), secret::new(2), secret::new(1)])) == 2
  assert set::size(set::from_list([secret::new(0.0), secret::new(-0.0)])) == 1
  let keys = set::from_list([secret::new(sorted_set::from_list([1, 2, 3]))])
  assert set::contains(keys, secret::new(grown))
  io::println("ok")
}
