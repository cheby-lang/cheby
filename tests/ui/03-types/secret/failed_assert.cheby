// @mode: run-fail
// @decisions: D-1902
//! A failed comparison prints its operands' debug text, so a secret in one
//! stays hidden (§11.5).

import std::secret

type Login {
  user: String,
  password: secret::Secret<String>,
}

fn login(password: String) -> Login {
  Login { user: "ada", password: secret::new(password) }
}

fn main() {
  let typed = "hunter2"
  let stored = "correct horse"
  assert login(typed) == login(stored)
}
