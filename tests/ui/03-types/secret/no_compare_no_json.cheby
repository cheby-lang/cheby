// @mode: check-fail
// @decisions: D-1903
//! A secret satisfies `Show` only: it has no order, and it does not encode
//! as JSON (§8.2).

import std::json
import std::list
import std::secret

fn main() {
  let a = secret::new(1)
  let b = secret::new(2)
  let _ = a < b
  let _ = list::sort([a, b])
  let _ = json::list([a, b])
}
