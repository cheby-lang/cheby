// @mode: run-pass
// @decisions: D-1905, D-1906
//! Every function of `std::secret` runs in a constant, and a constant may
//! hold a secret (§4.5).

import std::io
import std::secret

type Config {
  user: String,
  password: secret::Secret<String>,
}

const config: Config = Config { user: "ada", password: secret::new("hunter2") }

const header: secret::Secret<String> = secret::map(config.password, fn(token) { "Bearer {token}" })

const exposed_header: String = secret::expose(header)

const text: String = "{header} {config:?}"

fn main() {
  io::println("{config:?} {header}")
  io::println(exposed_header)
  io::println(text)
}
