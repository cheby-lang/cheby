// @mode: run-pass
// @flags: --release
// @decisions: D-1902, D-1903, D-1904
//! The release profile prints, compares and hashes secrets as the debug
//! profile does (§3.13).

import std::io
import std::list
import std::secret
import std::set

fn main() {
  let tokens = list::map(["a", "b", "a"], secret::new)
  io::println("{tokens} {tokens:?}")
  assert set::size(set::from_list(tokens)) == 2
  assert tokens == [secret::new("a"), secret::new("b"), secret::new("a")]
  let lengths = list::map(tokens, fn(token) { secret::map(token, fn(text) { "{text}!" }) })
  io::println("{lengths:?}")
  list::each(lengths, fn(token) { io::println(secret::expose(token)) })
}
