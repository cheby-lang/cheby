// @mode: check-fail
// @decisions: D-1901
//! `Secret` is opaque: a package can neither match on it nor build one
//! without `secret::new` (§4.3).

import std::secret

fn read(s: secret::Secret<String>) -> String {
  let secret::Secret(text) = s
  text
}

fn make(text: String) -> secret::Secret<String> {
  secret::Secret(text)
}

fn main() {
  let _ = read(make("hunter2"))
}
