// @mode: check-fail
// @decisions: D-455, D-692, D-944
// @milestone: M2
//! A kernel that receives the running fiber's context takes it as its
//! first C argument, a signature only the compiler knows. Every name the
//! runtime exports is reserved for the standard library, so binding the
//! symbol of `channel::send` from a user module is E0055 (§12.5.1).

@!target(native)

import std::channel

@external(native, "cheby_channel_send")
pub fn send_directly<T>(sender: channel::Sender<T>, value: T) -> Result<Nil, T>
