// @mode: check-fail
// @decisions: D-1565, D-1581
//! A call of `context::key` nested inside a constant's initializer is
//! E0080, because only the call that is the whole initializer makes a key:
//! inside a tuple, inside `Some(…)`, passed to another function, and at
//! the end of a block (§10.11).

import std::context

const pair: (context::Key<Int>, Int) = (context::key(1), 2)

const some: Option<context::Key<Int>> = Some(context::key(1))

fn keep(what: context::Key<Int>) -> context::Key<Int> {
  what
}

const kept: context::Key<Int> = keep(context::key(1))

const in_block: context::Key<Int> = { context::key(1) }

fn main() {
  let (first, _) = pair
  assert context::get(first) == 1
  assert some != None
  assert context::get(kept) == 1
  assert context::get(in_block) == 1
}
