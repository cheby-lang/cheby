// @mode: run-pass
// @decisions: D-1044, D-1573
//! `fiber::timeout` continues with the context it was called with, both
//! when its limit passes while `f` sleeps inside `provide` and when `f`
//! panics inside `provide` (§10.8, §10.11).

import std::context
import std::duration
import std::fiber
import std::io
import std::time

const greeting: context::Key<String> = context::key("hello")

fn describe(outcome: Result<String, fiber::Timeout>) -> String {
  case outcome {
    Ok(text) => "Ok: {text}"
    Err(fiber::TimedOut) => "Err(TimedOut)"
    Err(fiber::Panicked(failure)) => {
      let text = fiber::message(failure)
      "Err(Panicked): {text}"
    }
  }
}

/// Panics with `text`. Its return type is the result type of `f`.
fn fail(text: String) -> String {
  panic as text
}

fn timed_out() -> String {
  let outcome = fiber::timeout(duration::milliseconds(10), fn() {
    context::provide(greeting, "sleeping", fn() {
      time::sleep(duration::hours(1))
      context::get(greeting)
    })
  })
  let text = describe(outcome)
  let now = context::get(greeting)
  "{text}, then {now}"
}

fn panicked() -> String {
  let outcome = fiber::timeout(duration::seconds(10), fn() {
    context::provide(greeting, "failing", fn() { fail("crash") })
  })
  let text = describe(outcome)
  let now = context::get(greeting)
  "{text}, then {now}"
}

fn returned() -> String {
  let outcome = fiber::timeout(duration::seconds(10), fn() {
    context::provide(greeting, "returning", fn() { context::get(greeting) })
  })
  let text = describe(outcome)
  let now = context::get(greeting)
  "{text}, then {now}"
}

fn main() {
  io::println(timed_out())
  io::println(panicked())
  io::println(returned())
  use <- context::provide(greeting, "outer")
  io::println(timed_out())
  io::println(panicked())
  io::println(returned())
}
