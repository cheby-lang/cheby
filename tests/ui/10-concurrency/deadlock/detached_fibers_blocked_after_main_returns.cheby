// @mode: run-pass
// @decisions: D-724, D-857, D-073, D-669
// @milestone: M2
//! Detached fibers blocked for good when `main` returns are no deadlock:
//! the root has finished, so the program exits with status 0 (§10.4). One
//! waits on a channel whose `Sender` it holds, the other at the end of a
//! scope whose member waits the same way.

import std::channel
import std::fiber
import std::io

fn wait_forever(ready: channel::Sender<Nil>) -> Result<Int, Nil> {
  let (keep, never) = channel::new::<Int>(1)
  let assert Ok(Nil) = channel::send(ready, Nil)
  let got = channel::receive(never)
  let _ = channel::send(keep, 0)
  got
}

fn wait_in_a_scope(ready: channel::Sender<Nil>) -> Nil {
  let outcome = {
    use owner <- fiber::scope()
    fiber::spawn(owner, fn() { wait_forever(ready) })
    Nil
  }
  let _ = outcome
}

fn main() {
  let (ready_tx, ready_rx) = channel::new::<Nil>(2)
  fiber::spawn_detached(fn() { wait_forever(ready_tx) })
  fiber::spawn_detached(fn() { wait_in_a_scope(ready_tx) })
  let assert Ok(Nil) = channel::receive(ready_rx)
  let assert Ok(Nil) = channel::receive(ready_rx)
  io::println("both detached fibers have started")
}
