// @mode: run-pass
// @decisions: D-667, D-102
// @milestone: M2
//! When an outer scope fails, a scope that one of its fibers has open is
//! cancelled with the same target. Unwinding passes through the inner
//! scope after its fibers have ended, without the inner `scope` call
//! returning, so no code after it runs (§10.7).

import std::channel
import std::fiber
import std::io

fn main() {
  let (ready_tx, ready_rx) = channel::new::<Nil>(1)
  let (stuck_tx, stuck_rx) = channel::new::<Nil>(0)
  let (report_tx, report_rx) = channel::new::<String>(1)
  let outcome = {
    use outer <- fiber::scope()
    let _ = fiber::spawn(outer, fn() {
      let inner = {
        use owner <- fiber::scope()
        let _ = fiber::spawn(owner, fn() { channel::receive(stuck_rx) })
        let assert Ok(Nil) = channel::send(ready_tx, Nil)
        // `main` keeps `stuck_tx` and sends nothing, so only the
        // cancellation ends these waits.
        channel::receive(stuck_rx)
      }
      channel::send(report_tx, "the inner scope returned {inner:?}")
    })
    let _ = fiber::spawn(outer, fn() {
      let _ = channel::receive(ready_rx)
      panic as "the outer scope failed"
    })
    Nil
  }
  case outcome {
    Ok(_) => io::println("the outer scope returned Ok")
    Err(failure) => io::println(fiber::message(failure))
  }
  let reported = channel::receive(report_rx)
  io::println("report: {reported:?}")
  // Unwinding released every `Receiver` of `stuck`.
  let sent = channel::send(stuck_tx, Nil)
  io::println("send after the scope: {sent:?}")
}
