// @mode: run-fail
// @exit: 3
// @decisions: D-1917, D-1022
//! `process::exit` kills every child still open, also one that a detached fiber holds, and does not
//! wait for it (§10.10). The child inherits standard output, which the harness reads to its end, so
//! a child left running would keep the test waiting for ten minutes.

import std::channel
import std::duration
import std::fiber
import std::io
import std::process
import std::time

fn main() {
  let (ready_tx, ready) = channel::new::<Nil>(1)
  fiber::spawn_detached(fn() {
    let spec = process::command("sleep", ["600"])
      |> process::with_stdout(_, process::inherited())
    process::with_child(spec, fn(_) {
      let _ = channel::send(ready_tx, Nil)
      time::sleep(duration::hours(1))
      Ok(Nil)
    })
  })
  let _ = channel::receive(ready)
  io::println("exiting while a child runs")
  process::exit(3)
}
