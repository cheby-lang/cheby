// @mode: check-pass
// @decisions: D-173
//! With `T: A + B`, `A::f(x)` and `B::f(x)` are distinct calls through
//! the two bounds (§8.5).

import std::io

pub interface Formal {
  fn greeting(Self) -> String
}

pub interface Casual {
  fn greeting(Self) -> String
}

pub fn both<T: Formal + Casual>(person: T) -> String {
  let formal = Formal::greeting(person)
  io::println(formal)
  Casual::greeting(person)
}

fn main() {}
