// @mode: check-fail
// @decisions: D-117
//! `dyn I` is allowed only if every function of `I` uses `Self` only as
//! its first parameter (§8.6).

pub interface Shape {
  fn area(Self) -> Float
  fn scale(Self, Float) -> Self
}

pub fn area_of(shape: dyn Shape) -> Float {
  Shape::area(shape)
}

fn main() {}
