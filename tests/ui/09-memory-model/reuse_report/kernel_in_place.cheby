// @mode: run-pass
// @milestone: M2
// @decisions: D-717, D-170, D-716, D-525
// @flags: --reuse-report
//! A call of a std kernel that updates its first argument in place gets a
//! line when that argument is at its last use, as 013's
//! `held |> set::insert(_, …) |> set::insert(_, …)` does: the kernel
//! writes into the set when it is unique at run time (D-525). The second
//! call gets the first one's result, a temporary value. A set used again
//! after the call gets no line.

import std::io
import std::set

fn take(held: set::Set<Int>, first: Int, second: Int) -> set::Set<Int> {
  let taken = held |> set::insert(_, first) |> set::insert(_, second)
  taken
}

fn main() {
  let empty: set::Set<Int> = set::new()
  let held = take(empty, 1, 2)
  let more = set::insert(held, 3)
  let before = set::size(held)
  let after = set::size(more)
  io::println("{before}, then {after}")
}
