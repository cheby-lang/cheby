// @mode: run-pass
// @milestone: M2
// @decisions: D-717, D-170, D-716, D-852, D-911
// @flags: --reuse-report
//! A record update whose base is used again afterwards cannot reuse it:
//! the old value must stay as it is, so the update allocates, and the
//! report says why. Here `describe` gets the whole base after the update.
//! A base that is only read field by field afterwards is another case:
//! those reads move before the update, which then reuses the base
//! (`record_update_before_reads`).

import std::io

type Counter { name: String, count: Int }

fn describe(counter: Counter) -> String {
  "{counter.name}: {counter.count}"
}

fn main() {
  let before = Counter { name: "visits", count: 1 }
  let after = Counter { ..before, count: before.count + 1 }
  let old = describe(before)
  io::println("{old}, then {after.count}")
}
