// @mode: run-pass
// @decisions: D-205, D-893
// @milestone: M2
//! An owned slice releases the elements it cuts that only its list holds
//! (§9.2), so a `Sender` walked out of a list with `[first, ..rest]`
//! closes its channel at its last use, while `rest` is still alive. Before
//! D-893, the second `receive` blocked forever. A slice made by a
//! `std::list` function, which borrows its list, may keep the elements it
//! cuts until the slice itself dies; the channel is closed by then.

import std::channel
import std::io
import std::list

fn walked_out() -> Nil {
  let (tx, rx) = channel::new::<Int>(1)
  let (other, _other_rx) = channel::new::<Int>(1)
  case [tx, other] {
    [first, ..rest] => {
      let assert Ok(Nil) = channel::send(first, 1)
      let a = channel::receive(rx)
      let b = channel::receive(rx)
      let n = list::length(rest)
      io::println("walked out: {a:?} {b:?} {n}")
    }
    [] => Nil
  }
}

fn kept_by_a_shared_slice() -> Nil {
  let (tx, rx) = channel::new::<Int>(1)
  let (other, _other_rx) = channel::new::<Int>(1)
  let assert Ok(Nil) = channel::send(tx, 2)
  let tail = list::drop([tx, other], 1)
  let n = list::length(tail)
  // `tail` is not used again, so the slice and the `Sender` it kept are
  // released here.
  let a = channel::receive(rx)
  let b = channel::receive(rx)
  io::println("kept until the slice dies: {a:?} {b:?} {n}")
}

fn main() {
  walked_out()
  kept_by_a_shared_slice()
}
