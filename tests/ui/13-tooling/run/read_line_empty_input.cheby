// @mode: run-pass
// @decisions: D-305, D-474, D-543
//! An empty `.stdin` gives a standard input that is closed before the
//! program reads it, and `io::read_line` sees the end of input.

import std::io

fn main() {
  case io::read_line() {
    Ok(None) => io::println("end of input")
    Ok(Some(_)) => io::println("a line")
    Err(_) => io::println("an error")
  }
}
