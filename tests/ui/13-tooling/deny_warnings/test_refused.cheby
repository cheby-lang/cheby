// @mode: run-fail
// @exit: 1
// @command: test
// @flags: --deny-warnings
// @decisions: D-541, D-549
//! With `--deny-warnings`, a warning stops `cheby test` before any test
//! is compiled or run.

fn double(n: Int) -> Int {
  let unused = n
  n * 2
}

test "doubles" {
  assert double(2) == 4
}

fn main() {
  assert double(1) == 2
}
