// @mode: run-fail
// @exit: 1
// @command: test
// @decisions: D-458, D-541, D-543, D-784, D-944
//! In a toolchain with debug assertions, a passing test that leaves objects
//! alive fails with the leak check's message, which names the leaked kinds.
//! This one leaks on purpose: it sends a channel's receiver into the channel
//! itself, so the channel keeps itself alive, a leak §9.6 documents.

import std::channel

type Mail { Mail(channel::Receiver<Mail>) }

test "leaks a receiver" {
  let (tx, rx) = channel::new(1)
  let _ = channel::send(tx, Mail(rx))
  assert True
}

test "leaks nothing" {
  assert 1 + 1 == 2
}
