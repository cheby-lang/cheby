// @mode: check-pass
// @decisions: D-080, D-152, D-516
//! A `priv` item that no other item of its module uses warns. Calls of an
//! item from its own body do not count.

priv fn twice(n: Int) -> Int {
  n * 2
}

priv fn countdown(n: Int) -> Int {
  case n {
    0 => 0
    _ => countdown(n - 1)
  }
}

priv const limit: Int = 10

priv type Color {
  Red,
  Green,
}

pub fn answer() -> Int {
  42
}

fn main() {
  assert answer() == 42
}
