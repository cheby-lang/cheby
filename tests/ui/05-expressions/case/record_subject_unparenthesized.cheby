// @mode: parse-fail
// @decisions: D-052
//! In a `case` subject, an `UPPER` name followed by `{` is not a record
//! construction, because the `{` opens the arms, so a record subject must
//! be parenthesized (§5.9.6).

type Point {
  x: Int,
  y: Int,
}

fn origin_x() -> Int {
  case Point { x: 0, y: 1 } {
    Point { x, .. } => x
  }
}

fn main() {
  assert origin_x() == 0
}
