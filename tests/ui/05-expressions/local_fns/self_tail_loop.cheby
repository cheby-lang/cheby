// @mode: run-pass
// @decisions: D-015, D-110, D-453
//! A local function calls itself in tail position ten million times in
//! constant stack, and a closure inside a local function may call it
//! (§5.8, §5.15.3).

import std::io

fn count_to(limit: Int) -> Int {
  fn step(i, acc) {
    case {
      i == limit => acc
      _ => step(i + 1, acc + 2)
    }
  }
  step(0, 0)
}

fn sum_down(n: Int) -> Int {
  fn down(i, acc) {
    let next = fn(total) { down(i - 1, total) }
    case {
      i == 0 => acc
      _ => next(acc + i)
    }
  }
  down(n, 0)
}

fn main() {
  let counted = count_to(10_000_000)
  let summed = sum_down(1_000_000)
  io::println("{counted} {summed}")
}
