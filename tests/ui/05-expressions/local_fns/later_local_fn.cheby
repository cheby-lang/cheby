// @mode: check-fail
// @decisions: D-110
//! A local function may call itself, but not a local function declared
//! after it (§5.8).

fn main() {
  fn is_even(n) {
    case n {
      0 => True
      _ => is_odd(n - 1)
    }
  }
  fn is_odd(n) {
    case n {
      0 => False
      _ => is_even(n - 1)
    }
  }
  assert is_even(4) && is_odd(3)
}
