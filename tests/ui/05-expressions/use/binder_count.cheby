// @mode: check-fail
// @decisions: D-023, D-495
//! The binders of a `use` are the callback's parameters, so their number
//! must match (§5.10).

pub fn try(value: Result<Int, String>, next: fn(Int) -> Result<Int, String>) -> Result<Int, String> {
  case value {
    Ok(v) => next(v)
    Err(e) => Err(e)
  }
}

pub fn both(a: Result<Int, String>) -> Result<Int, String> {
  use x, y <- try(a)
  Ok(x + y)
}
