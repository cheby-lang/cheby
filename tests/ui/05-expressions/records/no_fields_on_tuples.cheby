// @mode: check-fail
// @decisions: D-241
//! Tuples and positional fields have no names. Read them with a pattern
//! (§5.11.3).

type Wrapper {
  Wrapped(Int),
}

fn first(pair: (Int, Int)) -> Int {
  pair.first
}

fn unwrap(w: Wrapper) -> Int {
  w.value
}

fn main() {
  assert first((1, 2)) + unwrap(Wrapped(3)) == 4
}
