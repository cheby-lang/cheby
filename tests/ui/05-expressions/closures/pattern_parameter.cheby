// @mode: check-pass
// @decisions: D-242
//! A closure parameter may be an irrefutable pattern (§5.7).

pub fn apply(f: fn((Int, Int)) -> Int, pair: (Int, Int)) -> Int {
  f(pair)
}

pub fn main() {
  let sum = apply(fn((a, b)) { a + b }, (1, 2))
  let typed = fn((key, value): (String, Int)) {
    case key {
      "" => 0
      _ => value + 1
    }
  }
  assert sum == 3 && typed(("k", 4)) == 5
}
