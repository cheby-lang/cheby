// @mode: run-fail
// @milestone: M3
// @decisions: D-1040, D-1647
//! With `CHEBY_BACKTRACE=1`, the backtrace of `expect`'s panic starts at
//! the function that called `expect`, at that call, as the backtrace of
//! `joined fiber failed` starts at the call of `fiber::join`: the std
//! constructor that raised it is not shown (§11.6).

import std::io
import std::map
import std::option

fn lookup(names: map::Map<Int, String>, id: Int) -> String {
  let name = option::expect(map::get(names, id), "every id has a name")
  "<{name}>"
}

fn main() {
  let names = map::from_list([(1, "one")])
  let first = lookup(names, 1)
  io::println(first)
  let second = lookup(names, 2)
  io::println(second)
}
