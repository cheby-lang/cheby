// @mode: run-fail
// @milestone: M3
// @decisions: D-1039, D-1040, D-1448
//! With `CHEBY_BACKTRACE=1`, a panic in the comparison of a direct call of
//! `list::sort_with`, which `sort_with`'s own code calls between the
//! runtime's steps, lists the comparison's frame and every frame below it,
//! as for any call of a function value (§11.6).

import std::int
import std::io
import std::list

fn refuse(a: Int, b: Int) -> Order {
  case a == 3 || b == 3 {
    True => panic as "cannot compare {a} and {b}"
    False => int::compare(a, b)
  }
}

fn ordered(xs: List<Int>) -> List<Int> {
  let sorted = list::sort_with(xs, refuse)
  sorted
}

fn main() {
  let sorted = ordered([5, 1, 4, 3, 2])
  io::println("{sorted:?}")
}
