//! `CHEBY_BACKTRACE` takes only `0` and `1`: any other value, here `yes`,
//! stops the program before `main` runs, with an error and status 1, as a
//! bad `CHEBY_THREADS` does (§11.6).

import std::io

fn main() {
  io::println("never printed")
}
