// @mode: run-fail
// @milestone: M3
// @decisions: D-1039, D-1040, D-1235, D-697, D-1765
//! With `CHEBY_BACKTRACE=1`, a panic in the callback of a std kernel,
//! called at the call site, lists the callback's frame and ends where the
//! kernel called it, outside Cheby code (§11.6).

import std::io
import std::map

fn refuse(old: Option<Int>) -> Int {
  case old {
    Some(n) => panic as "cannot update {n}"
    None => 0
  }
}

fn update(counts: map::Map<String, Int>) -> Int {
  let next = map::upsert(counts, "a", refuse)
  map::size(next)
}

fn main() {
  let n = update(map::from_list([("a", 1)]))
  io::println("{n}")
}
