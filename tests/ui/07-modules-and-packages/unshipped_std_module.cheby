// @mode: check-fail
// @decisions: D-477, D-480, D-554, D-729, D-989, D-1049, D-1563, D-1575
//! An import of a standard-library module that the plan names but `std/`
//! does not ship yet, `std::log` since `std::context` ships with M4's
//! native work, is the only E0038, and paths through such an import
//! report nothing more, even made-up ones, since `std::log` has no API yet.

import std::io
import std::log

const level: log::Level = log::info

fn main() {
  let _ = log::write(level, "planned")
  io::println("planned")
}
