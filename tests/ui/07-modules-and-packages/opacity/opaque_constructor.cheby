// @mode: check-fail
// @decisions: D-048, D-487
//! The constructors of a `pub` type from another package are usable only
//! if the type is `exposed`, so a `json::decode::Decoder` cannot be built or
//! matched here (§4.3.4, §6.4).

import std::json::decode

fn forged() -> decode::Decoder<Int> {
  decode::Decoder(fn(_, _) { (1, []) })
}

fn inner(decoder: decode::Decoder<Int>) -> Int {
  case decoder {
    decode::Decoder(_) => 1
  }
}

fn main() {
  assert inner(forged()) == 1
}
