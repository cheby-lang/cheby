// @mode: check-fail
// @decisions: D-148
//! Bounds are part of a function's signature, so a `pub` function must not
//! name a package-visible interface in them (§4.1.3).

interface Describe {
  fn describe(Self) -> String
}

pub fn label<T: Describe>(item: T) -> String {
  Describe::describe(item)
}
