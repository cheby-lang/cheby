// @mode: check-fail
// @decisions: D-195, D-536, D-617
//! One kernel call that asks for far more than the memory limit is
//! stopped before the memory is allocated and reported as E0076, so the
//! compiler never fails to allocate it (§13.9).

import std::io
import std::string

const big: String = string::repeat("a", 100_000_000_000_000)

fn main() {
  let size = string::length(big)
  io::println("{size}")
}
