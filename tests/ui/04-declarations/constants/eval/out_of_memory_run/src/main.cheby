// @mode: run-fail
// @decisions: D-449, D-457, D-617, D-642
//! At run time there is no memory limit, and a request that no memory can
//! serve panics with `out of memory` at an unknown location, inside the
//! kernel. The same call in a constant is E0076 (§4.5, §11.8).

import std::io
import std::string

fn copies(text: String, count: Int) -> Int {
  string::length(string::repeat(text, count))
}

fn main() {
  io::println("before")
  let size = copies("abc", 9_000_000_000_000_000_000)
  io::println("{size}")
}
