// @decisions: D-607, D-608, D-609
> fn scale(n: Int) -> Int {
.   n
. }
> fn twice(n: Int) -> Int {
.   scale(n) * 2
. }
> twice(1)
2 : Int
> fn scale(_n: Int) -> String {
.   "no"
. }
error[E0047]: mismatched types
 --> <repl:2>:2:14
  |
2 |   scale(n) * 2
  |   --------   ^ expected `String`, found `{integer}`
  |   |
  |   the left operand of `*` has type `String`
  |
  = note: `twice` was checked again because a definition it uses changed its signature; it keeps its old definition

