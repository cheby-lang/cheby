> io::write_file("src/other.cheby", r#"//! With its names, but private.
. /// A record, in both namespaces.
. priv type Point {
.   Point { x: Int },
. }
. /// A type that hides the prelude's.
. priv type Option {
.   Nothing,
. }
. /// An interface for a generic bound.
. priv interface Sized {
.   fn size(Self) -> Int
. }
. /// A constant.
. priv const limit: Int = 1
. /// A function.
. priv fn value() -> Int {
.   1
. }
. priv fn width(p: Point) -> Int {
.   p.x
. }
. priv fn size(_o: Option) -> Int {
.   1
. }
. priv fn measured<T: Sized>(t: T) -> Int {
.   Sized::size(t)
. }
. /// A function that no reload touches.
. pub fn stays() -> Int {
.   value() + width(Point { x: limit }) + measured(Nothing)
. }
. "#)
Ok(Nil) : Result<Nil, io::Error>
