    v10 = iadd v8, v9  ; v9 = -1
    v11 = iconst.i32 0x7fff_fffe
    v12 = icmp ult v10, v11  ; v11 = 0x7fff_fffe
    v13 = iconst.i32 0
    v14 = icmp eq v8, v13  ; v13 = 0
    brif v12, block4, block7

block7:
    brif.i8 v14, block6, block5

block4:
    v15 = iconst.i32 1
    v16 = iadd.i32 v8, v15  ; v15 = 1
    store notrap aligned v16, v1
    jump block6

block5 cold:
    v17 = symbol_value.i64 gv0
    v18 = load.i64 notrap aligned readonly v17
    call_indirect sig0, v18(v1)
    jump block6

block6:
    jump block0

block0:
    v19 = load.i64 notrap aligned v1+8
    v20 = iconst.i64 -2
    v21 = band v19, v20  ; v20 = -2
    v22 = call_indirect sig1, v21(v0, v1, v2, v3, v4, v5)
    brif v22, block8, block1

block8:
    return v22

block1 cold:
    v23 = iconst.i64 0
    return v23  ; v23 = 0
}
