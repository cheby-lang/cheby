    v13 = iconst.i32 0
    v14 = icmp eq v8, v13  ; v13 = 0
    brif v12, block4, block7

block7:
    brif.i8 v14, block6, block5

block4:
    v15 = iconst.i32 1
    v16 = iadd.i32 v8, v15  ; v15 = 1
    store notrap aligned v16, v1
    jump block6

block5 cold:
    call fn0(v1)
    jump block6

block6:
    jump block0

block0:
    v17 = load.i64 notrap aligned v1+8
    v18 = iconst.i64 -2
    v19 = band v17, v18  ; v18 = -2
    v20 = call_indirect sig1, v19(v0, v1, v2, v3, v4, v5)
    brif v20, block8, block1

block8:
    return v20

block1 cold:
    v21 = iconst.i64 0
    return v21  ; v21 = 0
}
