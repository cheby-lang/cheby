fn closures() {
  let add = fn(a, b) { a + b }
  let typed = fn(a: Int) -> Int { a }
  let destructure = fn((a, b)) { a }
  fn local(x: Int) -> Int {
    x + 1
  }
  fn helper(n) { n }
  list::map(xs, int::add(1, _))
  list::fold(xs, 0, fn(acc, (_, quantity)) { acc + quantity })
}

fn cases() {
  let a = case x {
    Some(v) when v > 1 => v
    _ => 0
  }
  let b = case x, y {
    0, _ => "zero"
    _, _ => "other"
  }
  let c = case {
    n > 0 => "positive"
    _ => "other"
  }
  let d = case Red {
    Red => 1
    _ => 0
  }
  let e = case (Point { x: 0, y: 0 }) {
    _ => 0
  }
  let f = case shape::Circle {
    _ => 0
  }
}

