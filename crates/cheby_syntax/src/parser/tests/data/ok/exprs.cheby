//! Expressions (App. A.5).
fn precedence() {
  let a = 1 + 2 * 3 - 4 / 5 % 6
  let b = x << 1 >> 2 & 3 ^ 4 | 5
  let c = xs |> list::length == 3 && !done || -a < b
  let d = -x.field.inner(1)(2)
  let e = !(a == b) != c
  let f = a <= b
  let g = a >= b
  let h = a > b
}

